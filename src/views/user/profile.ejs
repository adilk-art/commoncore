<!DOCTYPE html>
<html>

<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Account</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >

  <link rel="stylesheet" href="/css/user/standard.css">
  <link rel="stylesheet" href="/css/user/profile.css">
  <link rel="stylesheet" href="/css/user/style.css">
  <link rel="stylesheet" href="/css/user/global.css">
  <link rel="stylesheet" href="/css/user/toast.css">
  <link rel="stylesheet" href="/css/user/user-header.css">

</head>

<body>

  <%- include("../partials/user-header") %>
  <%- include("../partials/user-logout-modal") %>


  <div class="account-container">

    <%- include("../partials/sidebar", { active: "profile" }) %>

    <div class="main-content">

      <!-- PAGE HEADER -->

<div class="page-header">

  <div class="page-header-text">
    <h2 class="page-title">MY ACCOUNT</h2>
    <p class="page-subtitle">Manage your account details and referrals</p>
  </div>

  <a
    href="/user/profile/edit"
    class="edit-btn"
  >
    <i class="fa-regular fa-pen-to-square"></i>
    Edit Profile
  </a>

</div>


      <!-- PROFILE BANNER -->

      <div class="profile-banner">

        <div class="profile-banner-left">

          <img
            src="<%= user.profileImage || '/images/default.png' %>"
            alt="profile"
          >

          <div class="profile-user">

            <span class="welcome-text">
              Welcome Back
            </span>

            <h3>
              <%= user.name %>
            </h3>

            <p>
              <%= user.email %>
            </p>

          </div>

        </div>

      </div>


      <!-- DETAILS -->

      <div class="account-details-card">

        <div class="section-title">

          <h3>
            Account Information
          </h3>

        </div>


        <div class="info-grid">

          <div class="info-item">

            <span>
              Full Name
            </span>

            <h4>
              <%= user.name %>
            </h4>

          </div>


          <div class="info-item">

            <span>
              Email Address
            </span>

            <h4>
              <%= user.email %>
            </h4>

          </div>


          <div class="info-item">

            <span>
              Phone Number
            </span>

            <h4>
              <%= user.phone || "Not added" %>
            </h4>

          </div>

        </div>

      </div>
      <div class="referral-card">

  <div class="referral-header">

    <div>
      <span class="referral-eyebrow">
        Refer & Earn
      </span>

      <h3>
        Invite friends. Earn rewards.
      </h3>

      <p>
        Share your referral code with friends.
        You'll receive ₹<%= referral.referrerReward %>
        and they'll receive ₹<%= referral.friendReward %>
        in wallet credit after their first successful order.
      </p>
    </div>

    <div class="referral-reward-badge">
      Earn ₹<%= referral.referrerReward %>
    </div>

  </div>

  <div class="referral-main">

    <div class="referral-code-section">

      <span class="referral-label">
        Your Referral Code
      </span>

      <div class="referral-code-box">

        <strong id="referralCode">
          <%= referral.referralCode %>
        </strong>

        <button
          type="button"
          class="copy-referral-btn"
          id="copyReferralBtn"
          data-code="<%= referral.referralCode %>"
        >
          <i class="fa-regular fa-copy"></i>
          <span>Copy</span>
        </button>

      </div>

      <p class="referral-note">
        Your friend must sign up using this code.
      </p>

    </div>

    <div class="referral-benefits">

      <div class="referral-benefit">

        <span>
          You Earn
        </span>

        <strong>
          ₹<%= referral.referrerReward %>
        </strong>

      </div>

      <div class="referral-benefit">

        <span>
          Friend Gets
        </span>

        <strong>
          ₹<%= referral.friendReward %>
        </strong>

      </div>

    </div>

  </div>

  <div class="referral-stats">

    <div class="referral-stat">

      <span>
        Successful Referrals
      </span>

      <strong>
        <%= referral.successfulReferrals %>
      </strong>

    </div>

    <div class="referral-stat">

      <span>
        Pending Referrals
      </span>

      <strong>
        <%= referral.pendingReferrals %>
      </strong>

    </div>

    <div class="referral-stat">

      <span>
        Total Earned
      </span>

      <strong>
        ₹<%= Number(
          referral.totalEarnings,
        ).toLocaleString("en-IN") %>
      </strong>

    </div>

  </div>

</div>

    </div>

  </div>

  <script src="/js/user/logout.js"></script>
  <script src="/js/utils/toast.js"></script>
  <script src="/js/user/profile.js"></script>

</body>

</html>