<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Contact Us</title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <link rel="stylesheet" href="/css/user/standard.css" />
    <link rel="stylesheet" href="/css/user/style.css" />
    <link rel="stylesheet" href="/css/user/user-header.css" />
    <link rel="stylesheet" href="/css/user/toast.css" />
    <link rel="stylesheet" href="/css/user/contact.css" />
    <link rel="stylesheet" href="/css/user/contact.css" />
    <link rel="stylesheet" href="/css/user/footer.css" />
  </head>

  <body>
    <%- include("../partials/user-header") %>

    <main class="contact-page">
      <section class="contact-header">
        <p class="contact-eyebrow">GET IN TOUCH</p>

        <h1>Contact Us</h1>

        <p class="contact-subtitle">
          Have a question about your order, product, or account? Send us a
          message and we'll get back to you.
        </p>
      </section>

      <section class="contact-container">
        <div class="contact-info">
          <div class="contact-info-header">
            <p class="contact-info-eyebrow">COMMONCORE SUPPORT</p>

            <h2>We're here to help</h2>

            <p>
              Reach out to us with any questions or concerns. Our team will
              respond as soon as possible.
            </p>
          </div>

          <div class="contact-details">
            <div class="contact-detail">
              <div class="contact-icon">
                <i class="fa-regular fa-envelope"></i>
              </div>

              <div>
                <span>Email</span>

                <a href="mailto:teamcommoncore@gmail.com">
                  teamcommoncore@gmail.com
                </a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-icon">
                <i class="fa-solid fa-phone"></i>
              </div>

              <div>
                <span>Phone</span>

                <a href="tel:+919447152932"> +91 94471 52932 </a>
              </div>
            </div>
          </div>
        </div>

        <div class="contact-form-card">
          <div id="contactFormSection">
            <div class="contact-form-header">
              <h2>Send us a message</h2>

              <p>Fill in the details below and we'll get back to you.</p>
            </div>

            <form id="contactForm" novalidate>
              <div class="contact-field">
                <label for="contactName"> Name </label>

                <input
                  type="text"
                  id="contactName"
                  name="name"
                  placeholder="Enter your name"
                  autocomplete="name"
                />

                <span class="contact-error" id="nameError"></span>
              </div>

              <div class="contact-field">
                <label for="contactEmail"> Email </label>

                <input
                  type="email"
                  id="contactEmail"
                  name="email"
                  placeholder="Enter your email"
                  autocomplete="email"
                />

                <span class="contact-error" id="emailError"></span>
              </div>

              <div class="contact-field">
                <label for="contactSubject"> Subject </label>

                <input
                  type="text"
                  id="contactSubject"
                  name="subject"
                  placeholder="What can we help you with?"
                />

                <span class="contact-error" id="subjectError"></span>
              </div>

              <div class="contact-field">
                <label for="contactMessage"> Message </label>

                <textarea
                  id="contactMessage"
                  name="message"
                  placeholder="Tell us how we can help..."
                  rows="6"
                ></textarea>

                <span class="contact-error" id="messageError"></span>
              </div>

              <button
                type="submit"
                class="contact-submit-btn"
                id="contactSubmitBtn"
              >
                <span class="submit-text"> Send Message </span>

                <i class="fa-regular fa-paper-plane"></i>
              </button>
            </form>
          </div>

          <div class="contact-success" id="contactSuccess">
            <div class="contact-success-icon">
              <i class="fa-solid fa-check"></i>
            </div>

            <h2>Message sent</h2>

            <p>
              Thanks for contacting Commoncore. We've received your message and
              will get back to you as soon as possible.
            </p>

            <div class="contact-success-actions">
              <a href="/user/shop" class="contact-shop-btn">
                Continue Shopping
                <i class="fa-solid fa-arrow-right"></i>
              </a>

              <button
                type="button"
                class="contact-another-btn"
                id="sendAnotherMessageBtn"
              >
                Send Another Message
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/user-footer') %>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/utils/toast.js"></script>
    <script src="/js/user/contact.js"></script>

  </body>
</html>
