<!DOCTYPE html>
<html lang="en">

<head>
  <title>Shop — Commoncore</title>

  <%- include("../partials/user-head") %>

  <link
    rel="stylesheet"
    href="/css/user/shop.css"
  >
</head>

<body>

  <%- include("../partials/user-header") %>

  <main class="shop-main">

    <div class="shop-hero">
      <p class="shop-hero__eyebrow">
        Collection
      </p>

      <h1 class="shop-hero__title">
        All Products
      </h1>
    </div>

    <div class="cat-bar">

      <a
        href="/user/shop?search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&page=1"
        class="cat-pill <%= category === '' ? 'cat-pill--active' : '' %>"
      >
        All
      </a>

      <% categories.forEach((cat) => { %>

        <a
          href="/user/shop?search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&category=<%= cat._id %>&page=1"
          class="cat-pill <%= category === String(cat._id) ? 'cat-pill--active' : '' %>"
        >
          <%= cat.name %>
        </a>

      <% }) %>

    </div>

    <div class="toolbar-row">

      <div class="toolbar-triggers">

        <button
          class="trigger-btn"
          id="filterBtn"
          type="button"
          aria-expanded="false"
          aria-controls="filterPanel"
        >

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="11" y1="18" x2="13" y2="18"/>
          </svg>

          <span class="trigger-label">
            Filter
          </span>

          <span class="trigger-hint">

            <svg
              width="11"
              height="11"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              opacity=".5"
            >
              <line x1="6" y1="4" x2="18" y2="4"/>
              <path d="M6 8h8a4 4 0 0 1 0 8H6l8 8"/>
            </svg>

            <svg
              width="11"
              height="11"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              opacity=".5"
            >
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <circle cx="7" cy="7" r="1"/>
            </svg>

          </span>

          <% if (category || minPrice || maxPrice) { %>
            <span class="trigger-dot"></span>
          <% } %>

        </button>

        <button
          class="trigger-btn"
          id="sortBtn"
          type="button"
          aria-expanded="false"
          aria-controls="sortPanel"
        >

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M11 5h10M11 9h7M11 13h4"/>
            <path d="M3 17l3 3 3-3"/>
            <line x1="6" y1="20" x2="6" y2="4"/>
          </svg>

          <span class="trigger-label">
            Sort
          </span>

          <span class="trigger-hint">

            <svg
              width="11"
              height="11"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              opacity=".5"
            >
              <polyline points="18 15 12 9 6 15"/>
            </svg>

            <svg
              width="14"
              height="11"
              viewBox="0 0 28 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              opacity=".5"
            >
              <text
                x="0"
                y="13"
                font-size="13"
                font-family="sans-serif"
                fill="currentColor"
                stroke="none"
              >
                Az
              </text>
            </svg>

          </span>

          <% if (sort) { %>
            <span class="trigger-dot"></span>
          <% } %>

        </button>

        <% const hasFilters = category || minPrice || maxPrice; %>

        <% if (hasFilters) { %>

          <a
            href="/user/shop?search=<%= search %>&sort=<%= sort %>&page=1"
            class="clear-filter-btn"
          >
            Clear Filters
          </a>

        <% } %>

      </div>

      <form
        class="search-form"
        action="/user/shop"
        method="GET"
        id="searchForm"
      >

        <input
          type="hidden"
          name="category"
          value="<%= category %>"
        >

        <input
          type="hidden"
          name="sort"
          value="<%= sort %>"
        >

        <input
          type="hidden"
          name="minPrice"
          value="<%= minPrice %>"
        >

        <input
          type="hidden"
          name="maxPrice"
          value="<%= maxPrice %>"
        >

        <input
          type="hidden"
          name="page"
          value="1"
        >

        <div class="search-wrap">

          <svg
            class="search-icon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>

          <input
            class="input-field search-input"
            type="text"
            name="search"
            value="<%= search %>"
            placeholder="Search…"
            autocomplete="off"
            id="searchInput"
          >

          <% if (search) { %>

            <a
              href="/user/shop?category=<%= category %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&page=1"
              class="search-clear"
              aria-label="Clear search"
            >
              <svg
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </a>

          <% } %>

        </div>

      </form>

    </div>

    <div
      class="panels-row"
      id="panelsRow"
    >

      <div
        class="panel"
        id="filterPanel"
        hidden
      >

        <form
          class="panel__form"
          action="/user/shop"
          method="GET"
        >

          <input
            type="hidden"
            name="search"
            value="<%= search %>"
          >

          <input
            type="hidden"
            name="sort"
            value="<%= sort %>"
          >

          <input
            type="hidden"
            name="page"
            value="1"
          >

          <div class="panel__group">

            <div class="price-range-wrap">

              <span class="price-sym">
                ₹
              </span>

              <input
                class="input-field price-input"
                type="number"
                name="minPrice"
                value="<%= minPrice %>"
                placeholder="Min"
                min="0"
              >

              <span class="price-sep">
                –
              </span>

              <span class="price-sym">
                ₹
              </span>

              <input
                class="input-field price-input"
                type="number"
                name="maxPrice"
                value="<%= maxPrice %>"
                placeholder="Max"
                min="0"
              >

            </div>

          </div>

          <div class="panel__group">

            <div class="cat-radio-wrap">

              <label class="cat-radio <%= category === '' ? 'cat-radio--active' : '' %>">

                <input
                  type="radio"
                  name="category"
                  value=""
                  <%= category === "" ? "checked" : "" %>
                >

                All

              </label>

              <% categories.forEach((cat) => { %>

                <label class="cat-radio <%= category === String(cat._id) ? 'cat-radio--active' : '' %>">

                  <input
                    type="radio"
                    name="category"
                    value="<%= cat._id %>"
                    <%= category === String(cat._id) ? "checked" : "" %>
                  >

                  <%= cat.name %>

                </label>

              <% }) %>

            </div>

          </div>

          <div class="panel__actions">

            <button
              type="submit"
              class="primary-btn panel-apply-btn"
            >
              Apply
            </button>

            <% if (category || minPrice || maxPrice) { %>

              <a
                href="/user/shop?search=<%= search %>&sort=<%= sort %>&page=1"
                class="clear-link"
              >
                Clear
              </a>

            <% } %>

          </div>

        </form>

      </div>

      <div
        class="panel"
        id="sortPanel"
        hidden
      >

        <form
          class="panel__form"
          action="/user/shop"
          method="GET"
          id="sortForm"
        >

          <input
            type="hidden"
            name="search"
            value="<%= search %>"
          >

          <input
            type="hidden"
            name="category"
            value="<%= category %>"
          >

          <input
            type="hidden"
            name="minPrice"
            value="<%= minPrice %>"
          >

          <input
            type="hidden"
            name="maxPrice"
            value="<%= maxPrice %>"
          >

          <input
            type="hidden"
            name="page"
            value="1"
          >

          <input
            type="hidden"
            name="sort"
            value="<%= sort %>"
            id="sortInput"
          >

          <div class="sort-option-list">

            <%
              const sorts = [
                {
                  val: "",
                  label: "Newest first",
                },
                {
                  val: "low",
                  label: "Price: Low → High",
                },
                {
                  val: "high",
                  label: "Price: High → Low",
                },
                {
                  val: "az",
                  label: "Name: A → Z",
                },
                {
                  val: "za",
                  label: "Name: Z → A",
                },
              ];
            %>

            <% sorts.forEach((sortItem) => { %>

              <button
                type="button"
                class="sort-option <%= sort === sortItem.val ? 'sort-option--active' : '' %>"
                data-val="<%= sortItem.val %>"
              >

                <%= sortItem.label %>

                <% if (sort === sortItem.val) { %>

                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>

                <% } %>

              </button>

            <% }) %>

          </div>

        </form>

      </div>

    </div>

    <div class="shop-divider">

      <span class="shop-divider__count">

        <%= products.length %>

        <% if (totalPages > 1) { %>
          of ~<%= totalPages * 8 %>
        <% } %>

        items

      </span>

    </div>

    <section class="product-section">

      <% if (products.length === 0) { %>

        <div class="empty-state">

          <svg
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
          >
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>

          <p class="empty-state__title">
            No products found
          </p>

          <p class="empty-state__sub">
            Try adjusting your filters or search
          </p>

          <a
            href="/user/shop"
            class="primary-btn"
          >
            Clear all
          </a>

        </div>

      <% } else { %>

        <div class="product-grid">

          <% products.forEach((product) => { %>

            <div class="product-card">

              <a
                href="/user/product/<%= product._id %>"
                class="product-card__link"
              >

                <div class="product-card__img-wrap">

                  <% if (product.defaultImage) { %>

                    <img
                      src="<%= product.defaultImage %>"
                      alt="<%= product.name %>"
                      class="product-card__img"
                      loading="lazy"
                    >

                  <% } else { %>

                    <div class="product-card__img-placeholder">

                      <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                      >
                        <rect
                          x="3"
                          y="3"
                          width="18"
                          height="18"
                          rx="2"
                        />
                        <circle
                          cx="8.5"
                          cy="8.5"
                          r="1.5"
                        />
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>

                    </div>

                  <% } %>

                  <% if (product.hasOffer) { %>

                    <div class="offer-badge-wrap">

                      <span class="offer-badge">

                        <span class="offer-badge-text">

                          <% if (product.discountType === "PERCENTAGE") { %>

                            <%= Number(product.discountValue) %>% OFF

                          <% } else { %>

                            ₹<%= Number(
                              product.discountValue
                            ).toLocaleString("en-IN") %> OFF

                          <% } %>

                        </span>

                        <% if (
                          product.discountType === "PERCENTAGE" &&
                          product.maxDiscountAmount != null
                        ) { %>

                          <span
                            class="offer-info"
                            tabindex="0"
                            role="button"
                            aria-label="Maximum discount ₹<%= Number(
                              product.maxDiscountAmount
                            ).toLocaleString('en-IN') %>"
                          >

                            i

                            <span
                              class="offer-tooltip"
                              role="tooltip"
                            >
                              Maximum discount
                              ₹<%= Number(
                                product.maxDiscountAmount
                              ).toLocaleString("en-IN") %>
                            </span>

                          </span>

                        <% } %>

                      </span>

                    </div>

                  <% } %>

                </div>

                <div class="product-card__info">

                  <p class="product-card__category">
                    <%= product.categoryId.name %>
                  </p>

                  <h3 class="product-card__name">
                    <%= product.name %>
                  </h3>

                  <div class="product-card__meta">

                    <div class="product-price-block">

                      <% if (product.hasOffer) { %>

                        <span class="product-card__price">
                          ₹<%= Number(
                            product.finalPrice
                          ).toLocaleString("en-IN") %>
                        </span>

                        <span class="product-card__old-price">
                          ₹<%= Number(
                            product.originalPrice
                          ).toLocaleString("en-IN") %>
                        </span>

                      <% } else { %>

                        <span class="product-card__price">
                          ₹<%= Number(
                            product.originalPrice
                          ).toLocaleString("en-IN") %>
                        </span>

                      <% } %>

                    </div>

                    <span class="product-card__vars">
                      <%= product.activeVariants.length %> var.
                    </span>

                  </div>

                </div>

              </a>

              <div class="card-actions">

                <form class="cart-form">

                  <input
                    type="hidden"
                    name="productId"
                    value="<%= product._id %>"
                  >

                  <button
                    type="submit"
                    class="cart-btn open-cart-modal"
                    data-product-name="<%= product.name %>"
                    data-original-price="<%= product.originalPrice %>"
                    data-final-price="<%= product.finalPrice %>"
                    data-has-offer="<%= product.hasOffer %>"
                    data-discount-type="<%= product.discountType || '' %>"
                    data-discount-value="<%= product.discountValue || '' %>"
                    data-offer-title="<%= product.offerTitle || '' %>"
                    data-max-discount="<%= product.maxDiscountAmount ?? '' %>"
                  >

                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                      <line x1="3" y1="6" x2="21" y2="6"/>
                      <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>

                    Add to cart

                  </button>

                </form>

                <form class="wish-form">

                  <input
                    type="hidden"
                    name="productId"
                    value="<%= product._id %>"
                  >

                  <button
                    type="submit"
                    class="wish-btn <%= product.isWishlisted ? 'wish-btn--active' : '' %>"
                    aria-label="<%= product.isWishlisted ? 'Remove from wishlist' : 'Add to wishlist' %>"
                  >

                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="<%= product.isWishlisted ? 'currentColor' : 'none' %>"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>

                  </button>

                </form>

              </div>

            </div>

          <% }) %>

        </div>

        <% if (totalPages > 1) { %>

          <nav class="pagination">

            <% if (currentPage > 1) { %>

              <a
                href="/user/shop?search=<%= search %>&category=<%= category %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&page=<%= currentPage - 1 %>"
                class="page-btn page-btn--arrow"
                aria-label="Previous page"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </a>

            <% } %>

            <%
              const delta = 2;
              const pages = [];

              for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
                if (
                  pageNumber === 1 ||
                  pageNumber === totalPages ||
                  (
                    pageNumber >= currentPage - delta &&
                    pageNumber <= currentPage + delta
                  )
                ) {
                  pages.push(pageNumber);
                }
              }

              let previousPage = null;
            %>

            <% pages.forEach((pageNumber) => { %>

              <% if (
                previousPage !== null &&
                pageNumber - previousPage > 1
              ) { %>

                <span class="page-ellipsis">
                  …
                </span>

              <% } %>

              <a
                href="/user/shop?search=<%= search %>&category=<%= category %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&page=<%= pageNumber %>"
                class="page-btn <%= pageNumber === currentPage ? 'page-btn--active' : '' %>"
              >
                <%= pageNumber %>
              </a>

              <% previousPage = pageNumber; %>

            <% }) %>

            <% if (currentPage < totalPages) { %>

              <a
                href="/user/shop?search=<%= search %>&category=<%= category %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&page=<%= currentPage + 1 %>"
                class="page-btn page-btn--arrow"
                aria-label="Next page"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>

            <% } %>

          </nav>

        <% } %>

      <% } %>

    </section>

  </main>

 <div
  class="variant-modal-backdrop"
  id="cartVariantModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="variantProductName"
>

  <div class="variant-modal">

    <button
      class="variant-close"
      id="closeCartVariantModal"
      type="button"
      aria-label="Close variant selection"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div class="variant-layout">

      <div class="variant-preview">

        <div class="variant-preview-image-wrap">

          <img
            src=""
            alt=""
            id="variantPreviewImage"
            class="variant-preview-image"
          >

          <span
            class="variant-image-stock"
            id="variantImageStock"
            hidden
          ></span>

        </div>

      </div>

      <div class="variant-details">

        <div class="variant-details-head">

          <p class="variant-small-label">
            Select your option
          </p>

          <h2
            class="variant-product-name"
            id="variantProductName"
          >
            Product Name
          </h2>

          <p class="variant-helper-text">
            Choose a color and size before adding this item to your cart.
          </p>

        </div>

        <div class="variant-price-wrap">

          <div class="variant-price-row">

            <div class="variant-price">
              ₹<span id="variantPreviewPrice">0</span>
            </div>

            <span
              class="variant-old-price"
              id="variantOriginalPrice"
              hidden
            >
              ₹0
            </span>

          </div>

          <div
            class="variant-offer-pills"
            id="variantOfferPills"
            hidden
          >

            <span
              class="variant-discount-pill"
              id="variantDiscountPill"
            ></span>

            <span
              class="variant-offer-pill"
              id="variantOfferNamePill"
            ></span>

          </div>

        </div>

        <div class="variant-divider"></div>

        <div class="variant-section">

          <div class="variant-section-head">

            <p class="variant-label">
              Color
            </p>

            <span
              class="variant-selected-value"
              id="variantSelectedColor"
            ></span>

          </div>

          <div
            class="variant-color-list"
            id="variantColorList"
          ></div>

        </div>

        <div class="variant-section">

          <div class="variant-section-head">

            <p class="variant-label">
              Size
            </p>

            <span
              class="variant-selected-value"
              id="variantSelectedSize"
            ></span>

          </div>

          <div
            class="variant-size-list"
            id="variantSizeList"
          ></div>

        </div>

        <div class="variant-selection-status">

          <p
            class="variant-stock"
            id="variantStockText"
          ></p>

          <p
            class="variant-error"
            id="cartVariantError"
          ></p>

        </div>

        <div class="variant-modal-footer">

          <button
            class="variant-confirm-btn"
            id="confirmCartVariant"
            type="button"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>

            <span>Add To Cart</span>
          </button>

          <p class="variant-footer-note">
            You can update the quantity from your cart.
          </p>

        </div>

      </div>

    </div>

  </div>

</div>
  <%- include('../partials/user-footer') %>

  <%- include("../partials/user-scripts") %>

  <script src="/js/user/shop.js"></script>

</body>

</html>