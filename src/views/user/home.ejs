<!DOCTYPE html>
<html lang="en">
  <head>
    <title>CommonCore — Common For All</title>

    <%- include("../partials/user-head") %>

    <link rel="stylesheet" href="/css/user/home.css" />
    <link rel="stylesheet" href="/css/user/footer.css" />
  </head>

  <body>
    <%- include("../partials/user-header") %>

    <main class="home-page">
      <section class="hero">
        <div class="hero-content">
          <p class="hero-eyebrow">COMMONCORE® / UNISEX ESSENTIALS</p>

          <h1>
            Designed for<br />
            every <span>body.</span>
          </h1>

          <p class="hero-description">
            Minimal unisex essentials made with quality fabrics, clean
            silhouettes and everyday comfort. Designed to be worn by anyone,
            anywhere.
          </p>

          <div class="hero-actions">
            <a href="/user/shop" class="hero-primary-btn">
              Shop Collection
              <i class="fa-solid fa-arrow-right"></i>
            </a>

            <a href="/user/about" class="hero-story-link">
              Our Story
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <img
            src="/images/hero-commoncore.png"
            alt="CommonCore unisex collection"
          />
        </div>
      </section>

      <section class="brand-points">
        <div class="brand-point">
          <span>01</span>

          <div>
            <strong>UNISEX</strong>
            <p>Designed for everyone</p>
          </div>
        </div>

        <div class="brand-point">
          <span>02</span>

          <div>
            <strong>QUALITY</strong>
            <p>Fabrics chosen to feel better</p>
          </div>
        </div>

        <div class="brand-point">
          <span>03</span>

          <div>
            <strong>MINIMAL</strong>
            <p>Essentials made beyond trends</p>
          </div>
        </div>
      </section>

      <section class="category-section">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">EXPLORE</p>
            <h2>Shop by category</h2>
          </div>

          <a href="/user/shop" class="view-all-link">
            View all
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="category-grid">
          <a
            href="/user/shop?category=6a0319106e95d204811a5784"
            class="category-card"
          >
            <div class="category-image">
              <img
                src="/images/category-tshirts.png"
                alt="CommonCore T-Shirts"
              />

              <div class="category-arrow">
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>

            <div class="category-info">
              <span>ESSENTIALS</span>

              <div>
                <h3>T-Shirts</h3>
                <p>Clean everyday basics</p>
              </div>
            </div>
          </a>

          <a
            href="/user/shop?category=6a0319066e95d204811a577c"
            class="category-card"
          >
            <div class="category-image">
              <img src="/images/category-jeans.png" alt="CommonCore Jeans" />

              <div class="category-arrow">
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>

            <div class="category-info">
              <span>DENIM</span>

              <div>
                <h3>Jeans</h3>
                <p>Easy structure for every day</p>
              </div>
            </div>
          </a>

          <a
            href="/user/shop?category=6a0319426e95d204811a578e"
            class="category-card"
          >
            <div class="category-image">
              <img
                src="/images/category-hoodies.png"
                alt="CommonCore Hoodies"
              />

              <div class="category-arrow">
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>

            <div class="category-info">
              <span>LAYERS</span>

              <div>
                <h3>Hoodies</h3>
                <p>Comfort in every layer</p>
              </div>
            </div>
          </a>
        </div>

        <div class="collection-link-wrap">
          <a href="/user/shop" class="collection-link">
            Explore the full collection
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </section>

      <section class="brand-statement">
        <p class="brand-statement-eyebrow">COMMON FOR ALL</p>

        <h2>
          No men's collection.<br />
          No women's collection.<br />
          <span>Just good essentials.</span>
        </h2>

        <p class="brand-statement-description">
          CommonCore creates versatile clothing around minimal design, quality
          fabrics and effortless comfort. Simple pieces made to work across
          people, styles and everyday life.
        </p>

        <a href="/user/about" class="brand-story-link">
          Discover our story
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </section>

      <section class="features-section">
        <div class="feature-item">
          <div class="feature-icon">
            <i class="fa-solid fa-layer-group"></i>
          </div>

          <div>
            <h3>Quality Fabrics</h3>

            <p>
              Carefully selected materials made for comfort, structure and
              everyday durability.
            </p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <i class="fa-solid fa-rotate-left"></i>
          </div>

          <div>
            <h3>Easy Returns</h3>

            <p>Simple returns within 14 days of delivery.</p>
          </div>
        </div>

        <div class="feature-item">
          <div class="feature-icon">
            <i class="fa-solid fa-truck-fast"></i>
          </div>

          <div>
            <h3>Reliable Delivery</h3>

            <p>
              Secure delivery with clear order tracking from checkout to your
              doorstep.
            </p>
          </div>
        </div>
      </section>
    </main>

    <%- include("../partials/user-footer") %> <%-
    include("../partials/user-scripts") %>
  </body>
</html>
