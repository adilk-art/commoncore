<!DOCTYPE html>
<html lang="en">

<head>
  <title>Wishlist — Stitch</title>

  <%- include('../partials/user-head') %>

  <link
    rel="stylesheet"
    href="/css/user/wishlist.css"
  >
</head>

<body>

<%- include('../partials/user-header') %>

<main class="wishlist-page">

  <section class="wishlist-card card card-lg">

    <div class="wishlist-head">

      <div>
        <h1 class="text-page-title">
          Wishlist
        </h1>
      </div>

      <div class="wishlist-head-right">

        <p class="wishlist-count">
          <%= items.length %>
          <%= items.length === 1 ? "item" : "items" %>
        </p>

        <% if (items.length > 0) { %>

          <button
            class="primary-btn"
            id="addAllBtn"
          >
            Add All to Cart
          </button>

        <% } %>

      </div>

    </div>

    <% if (items.length === 0) { %>

      <div class="wishlist-empty">

        <div class="wishlist-empty-icon">
          ♡
        </div>

        <h2 class="wishlist-empty-title">
          Your wishlist is empty
        </h2>

        <p class="wishlist-empty-text">
          Save items you love and they will appear here.
        </p>

        <a
          href="/user/shop"
          class="secondary-btn"
        >
          Continue Shopping
        </a>

      </div>

    <% } else { %>

      <div class="wishlist-grid">

        <% items.forEach(item => { %>

          <article class="wishlist-item">

            <a
              href="/user/product/<%= item.product._id %>"
              class="wishlist-image-wrap"
            >

              <img
                src="<%= item.variant?.images?.[0]?.url || '/images/no-image.png' %>"
                class="wishlist-image"
                alt="<%= item.product.name %>"
              >

              <% if (item.unavailable) { %>

                <span class="wishlist-stock-badge">
                  Unavailable
                </span>

              <% } else if (!item.inStock) { %>

                <span class="wishlist-stock-badge">
                  Out of Stock
                </span>

              <% } %>

            </a>

            <div class="wishlist-content">

              <div class="wishlist-product-info">

                <p class="wishlist-category">
                  <%= item.product.categoryId?.name || "Uncategorized" %>
                </p>

                <h3 class="wishlist-name">
                  <%= item.product.name %>
                </h3>

                <div class="wishlist-price-block">

                  <% if (item.variant) { %>

                    <div class="wishlist-price-row">

                      <span class="wishlist-price">
                        ₹<%= Number(
                          item.finalPrice
                        ).toLocaleString("en-IN") %>
                      </span>

                      <% if (item.hasOffer) { %>

                        <span class="wishlist-old-price">
                          ₹<%= Number(
                            item.originalPrice
                          ).toLocaleString("en-IN") %>
                        </span>

                        <span class="wishlist-offer-badge">

                          <% if (item.discountType === "PERCENTAGE") { %>

                            <%= Number(
                              item.discountValue
                            ) %>% OFF

                          <% } else { %>

                            ₹<%= Number(
                              item.discountValue
                            ).toLocaleString("en-IN") %> OFF

                          <% } %>

                        </span>

                      <% } %>

                    </div>

                
                  <% } else { %>

                    <p class="wishlist-price">
                      --
                    </p>

                  <% } %>

                </div>

              </div>

              <div class="wishlist-actions">

                <button
                  class="wishlist-cart-btn move-cart"
                  data-id="<%= item.product._id %>"
                  <%= !item.inStock ? "disabled" : "" %>
                >
                  Move to Cart
                </button>

                <button
                  class="wishlist-remove-btn remove-wishlist"
                  data-id="<%= item.product._id %>"
                >
                  Remove
                </button>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    <% } %>

  </section>

</main>

<div
  class="variant-modal"
  id="variantModal"
>

  <div class="variant-modal-content">

    <div class="variant-modal-head">

      <h3>
        Select Variant
      </h3>

      <button
        type="button"
        id="closeVariantModal"
      >
        ×
      </button>

    </div>

    <div
      class="variant-modal-error"
      id="variantModalError"
    ></div>

    <div
      class="variant-modal-body"
      id="variantOptions"
    ></div>

    <button
      type="button"
      class="primary-btn"
      id="confirmVariantBtn"
    >
      Add to Cart
    </button>

  </div>

</div>

<%- include('../partials/user-scripts') %>

<script src="/js/user/wishlist.js"></script>

</body>

</html>