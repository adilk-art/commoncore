<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    Order Details — Commoncore
  </title>

  <%- include('../partials/user-head') %>

  <link
    rel="stylesheet"
    href="/css/user/order-detail.css"
  >

</head>

<body>

<%- include('../partials/user-header') %>

<main class="order-detail-page">

  <% const hasMultipleItems = order.items.length > 1; %>

  <!-- HEADER -->

  <section class="order-header card card-md">

    <div>

      <h1 class="order-number">
        <%= order.orderNumber %>
      </h1>

      <p class="order-date">
        Placed on
        <%= new Date(order.createdAt).toLocaleDateString("en-IN",{
          day:"numeric",
          month:"long",
          year:"numeric"
        }) %>
      </p>

    </div>

   <div class="order-header-right">
  <a
    href="/user/order/<%= order._id %>/invoice"
    class="invoice-btn"
  >
    Download Invoice
  </a>

</div>

  </section>



  <!-- INFO GRID -->

 <section class="info-grid">

  <!-- Shipping Card -->
  <div class="card card-md">

    <h3 class="info-title">
      Shipping Details
    </h3>

<div class="shipping-box">

  <h4>
    <%= order.shippingAddress.fullName %>
  </h4>

  <p>
    <%= order.shippingAddress.line1 %>
  </p>

  <% if(order.shippingAddress.line2){ %>

  <p>
    <%= order.shippingAddress.line2 %>
  </p>

  <% } %>

  <p>
    <%= order.shippingAddress.city %>,
    <%= order.shippingAddress.state %>
  </p>

  <p>
    <%= order.shippingAddress.pincode %>
  </p>

  <p>
    +91 <%= order.shippingAddress.phone %>
  </p>

</div>

  </div>

  <!-- Order Information Card -->
  <div class="card card-md">

    <h3 class="info-title">
      Order Information
    </h3>

    <div class="order-info-box">

      <div class="info-row">
        <span>Items</span>
        <p>
          <%= order.items.length %>
        </p>
      </div>

      <div class="info-row">
        <span>Payment Method</span>
        <strong>
          <%= order.paymentMethod.replace(/([a-z])([A-Z])/g, "$1 $2") %>
        </strong>
      </div>

      <div class="info-row">
        <span>Payment Status</span>

        <strong class="payment-status
          <%= order.paymentStatus.toLowerCase() %>">

          <%= order.paymentStatus %>

        </strong>
      </div>


    </div>

  </div>

</section>


<section class="card card-md summary-card">

  <h2 class="summary-title">
    Order Summary
  </h2>

  <% order.items.forEach(item => { %>

 <div class="summary-item">

  <img
    src="<%= item.variantId.images?.[0]?.url %>"
    alt="<%= item.productName %>"
  >

  <div class="summary-item-content">

    <div class="item-top-row">
      <h4 class="item-title">
        <%= item.productName %>
        <span class="item-status-text item-status-<%= item.status.toLowerCase().replaceAll(' ', '-') %>">
          <%= item.status %>
        </span>
      </h4>
    </div>

    <p class="item-variant">
      <%= item.color %> /
      <%= item.size %>
      · Qty <%= item.quantity %>
    </p>

    <% if (item.statusMetaText) { %>
      <p class="item-meta-text">
        <%= item.statusMetaText %>
      </p>
    <% } %>

    <% if (item.canReturn) { %>
      <p class="item-return-text">
        Return available · <%= item.returnDaysLeft %> day<%= item.returnDaysLeft !== 1 ? "s" : "" %> left
      </p>
    <% } %>

  </div>

  <div class="summary-item-right">

<div class="item-price-breakdown">

  <div class="item-unit-price-row">
    <span class="unit-price">
      ₹<%= Number(
        item.unitPrice
      ).toLocaleString("en-IN") %>
      × <%= item.quantity %>
    </span>

    <% if (item.hasOffer) { %>
      <span class="item-old-unit-price">
        ₹<%= Number(
          item.originalUnitPrice ??
          item.unitPrice
        ).toLocaleString("en-IN") %>
      </span>
    <% } %>
  </div>

  <div class="item-line-price-row">
    <strong
      class="<%= item.status === 'Cancelled'
        ? 'price-cancelled'
        : '' %>"
    >
      ₹<%= Number(
        item.unitPrice *
        item.quantity
      ).toLocaleString("en-IN") %>
    </strong>

    <% if (item.hasOffer) { %>
      <span class="item-offer-badge">
        <% if (
          item.discountType ===
          "PERCENTAGE"
        ) { %>
          <%= Number(
            item.discountValue
          ) %>% OFF
        <% } else { %>
          ₹<%= Number(
            item.discountValue
          ).toLocaleString("en-IN") %> OFF
        <% } %>
      </span>
    <% } %>
  </div>

</div>

    <% if (item.canCancel) { %>
      <button
        class="secondary-btn cancel-item-btn"
        data-item-id="<%= item._id %>"
        data-order-id="<%= order._id %>"
        data-name="<%= item.productName %>"
        data-image="<%= item.variantId?.images?.[0]?.url || item.productImage || '/images/default-product.jpg' %>"
        data-size="<%= item.size %>"
        data-color="<%= item.color %>"
        data-price="<%= item.unitPrice * item.quantity %>"
      >
        Cancel Item
      </button>

    <% } else if (item.canReturn) { %>
      <a
        href="/user/returns/request/<%= order._id %>/<%= item._id %>"
        class="secondary-btn return-item-btn"
      >
        Return Item
      </a>

    <% } else if (item.showReturnStatusBtn) { %>
      <a
        href="/user/returns/<%= order._id %>/<%= item._id %>"
        class="secondary-btn return-status-btn"
      >
        View Return Status
      </a>
    <% } %>

  </div>

</div>

  <% }) %>

<div class="summary-divider"></div>

<% if (fullyCancelled) { %>

  <div class="summary-row">
    <span>Original subtotal</span>
    <span>
      ₹<%= Number(
        originalSubtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <% if (discountTotal > 0) { %>
    <div class="summary-row summary-discount">
      <span>Offer discount</span>
      <span>
        −₹<%= Number(
          discountTotal
        ).toLocaleString("en-IN") %>
      </span>
    </div>
  <% } %>

  <div class="summary-row">
    <span>Subtotal</span>
    <span>
      ₹<%= Number(
        order.subtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <div class="summary-row summary-cancelled">
    <span>Cancelled items</span>
    <span>
      −₹<%= Number(
        order.subtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <div class="summary-row">
    <span>Current subtotal</span>
    <span>₹0</span>
  </div>

  <div class="summary-row">
    <span>GST Included</span>
    <span>₹0.00</span>
  </div>

  <div class="summary-row">
    <span>Shipping</span>
    <span>Free</span>
  </div>

  <div class="summary-divider"></div>

  <div class="summary-row total-row">
    <span>Current total</span>
    <span>₹0</span>
  </div>

<% } else { %>

  <div class="summary-row">
    <span>Original subtotal</span>
    <span>
      ₹<%= Number(
        activeOriginalSubtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <% if (activeDiscountTotal > 0) { %>
    <div class="summary-row summary-discount">
      <span>Offer discount</span>
      <span>
        −₹<%= Number(
          activeDiscountTotal
        ).toLocaleString("en-IN") %>
      </span>
    </div>
  <% } %>

  <div class="summary-row">
    <span>
      <%= cancelledAmount > 0
        ? "Active subtotal"
        : "Subtotal" %>
    </span>

    <span>
      ₹<%= Number(
        activeSubtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <% if (cancelledAmount > 0) { %>
    <div class="summary-row summary-cancelled">
      <span>Cancelled items</span>
      <span>
        −₹<%= Number(
          cancelledAmount
        ).toLocaleString("en-IN") %>
      </span>
    </div>
  <% } %>

  <div class="summary-row">
    <span>Shipping</span>
    <span>
      <%= currentValue - activeSubtotal === 0
        ? "Free"
        : `₹${Number(
            currentValue - activeSubtotal
          ).toLocaleString("en-IN")}` %>
    </span>
  </div>

  <div class="summary-row summary-gst">
    <span>GST Included</span>
    <span>
      ₹<%= Number(
        gstAmount
      ).toFixed(2) %>
    </span>
  </div>

  <div class="summary-row">
    <span>Payment</span>
    <span>
      <%= order.paymentMethod.replace(
        /([a-z])([A-Z])/g,
        "$1 $2",
      ) %>
    </span>
  </div>

  <div class="summary-divider"></div>

  <div class="summary-row total-row">
    <span>
      <%= partiallyCancelled
        ? "Current total"
        : "Order total" %>
    </span>

    <span>
      ₹<%= Number(
        currentValue
      ).toLocaleString("en-IN") %>
    </span>
  </div>

<% } %>

</section>

 <!-- ACTIONS -->

<div class="order-actions">

<% if (order.items.some(item => item.canCancel)) { %>

  <button
    class="secondary-btn cancel-order-btn"
    data-order-id="<%= order._id %>"
  >
    Cancel Order
  </button>

<% } %>

  <a
    href="/user/shop"
    class="primary-btn continue-shopping-btn"
  >
    Continue Shopping
  </a>

</div>

  <div
  id="cancelItemModal"
  class="cancel-modal hidden"
>

  <div class="cancel-modal-content">

    <div class="modal-header">

      <h2>
        Cancel Order
      </h2>

      <button
        type="button"
        id="closeCancelModal"
        class="modal-close"
      >
        ×
      </button>

    </div>


    <div class="cancel-product">

      <img
        id="modalImage"
        src=""
        alt=""
      >

      <div>

        <h3 id="modalName"></h3>

        <p id="modalColor"></p>

        <p id="modalSize"></p>

        <strong id="modalPrice"></strong>

      </div>

    </div>

    <div class="modal-field">

      <label>
        Reason
      </label>

      <select
        id="cancelReason"
        class="select-field"
      >
        <option value="">
          Select Reason
        </option>

        <option value="Ordered by mistake">
          Ordered by mistake
        </option>

        <option value="Found better product">
          Found better product
        </option>

        <option value="Delivery taking too long">
          Delivery taking too long
        </option>

        <option value="Changed my mind">
          Changed my mind
        </option>

      </select>

    </div>

    <div class="modal-field">

      <label>
        Comments
      </label>

      <textarea
        id="cancelComment"
        class="input-field cancel-comment"
        placeholder="Additional comments"
      ></textarea>

    </div>

    <div class="cancel-modal-actions">

      <button
        id="keepItemBtn"
        class="secondary-btn"
      >
        Cancel
      </button>

      <button
        id="confirmCancelItem"
        class="primary-btn"
      >
        Confirm Cancellation
      </button>

    </div>

  </div>

</div>

</main>

<%- include('../partials/user-scripts') %>
  <script src="/js/user/orderDetail.js"></script>


</body>
</html>