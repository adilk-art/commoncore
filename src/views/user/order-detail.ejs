<!DOCTYPE html>
<html lang="en">

<head>
  <title>Order Details — Commoncore</title>
  <%- include("../partials/user-head") %>
  <link rel="stylesheet" href="/css/user/order-detail.css">
</head>

<body>

<%- include("../partials/user-header") %>

<main class="order-detail-page">

  <%
    const currentDisplayStatus =
      displayStatus ||
      order.orderStatus ||
      "Placed";

    const displayStatusClass =
      String(currentDisplayStatus)
        .toLowerCase()
        .trim()
        .replace(/\s+/g,"-");

    const isPaymentState =
      order.orderStatus === "Payment Pending" ||
      order.orderStatus === "Payment Expired";

    const currentPaymentStatus =
      isPaymentState
        ? "Failed"
        : order.paymentStatus;

    const paymentStatusClass =
      String(currentPaymentStatus)
        .toLowerCase()
        .trim()
        .replace(/\s+/g,"-");

    const money = value =>
      Number(value || 0).toLocaleString(
        "en-IN",
        {
          minimumFractionDigits:2,
          maximumFractionDigits:2,
        },
      );

    const paymentMethodText =
      order.paymentMethod === "CashOnDelivery"
        ? "Cash On Delivery"
        : order.paymentMethod.replace(
            /([a-z])([A-Z])/g,
            "$1 $2",
          );
  %>

  <section class="order-header card card-md">

    <div>

      <h1 class="order-number">
        <%= order.orderNumber %>
      </h1>

      <p class="order-date">
        <%= isPaymentState
          ? "Created on"
          : "Placed on" %>

        <%= new Date(
          order.createdAt,
        ).toLocaleDateString(
          "en-IN",
          {
            day:"numeric",
            month:"long",
            year:"numeric",
          },
        ) %>
      </p>

    </div>

    <div class="order-header-right">

      <span
        class="status-badge status-<%= displayStatusClass %>"
      >
        <%= currentDisplayStatus %>
      </span>

      <% if (canDownloadInvoice) { %>

        <a
          href="/user/order/<%= order._id %>/invoice"
          class="invoice-btn"
        >
          Download Invoice
        </a>

      <% } %>

    </div>

  </section>

  <% if (isPaymentState) { %>

    <section class="payment-recovery-card card card-md">

      <div class="payment-recovery-content">

        <div class="payment-recovery-icon">
          <i class="fa-solid fa-circle-exclamation"></i>
        </div>

        <div class="payment-recovery-text">

          <h2>
            Payment not completed
          </h2>

          <p>
            This order was not confirmed.
            Checkout again to continue with current stock,
            pricing, offers and availability.
          </p>

          <% if (
            paymentFailed &&
            order.paymentFailure?.description
          ) { %>

            <p class="payment-failure-reason">
              <%= order.paymentFailure.description %>
            </p>

          <% } %>

        </div>

      </div>

      <% if (canReturnToCheckout) { %>

        <button
          type="button"
          class="primary-btn checkout-again-btn"
          data-order-id="<%= order._id %>"
        >
          Checkout Again
        </button>

      <% } %>

    </section>

  <% } %>

  <section class="info-grid">

    <div class="card card-md info-card">

      <h3 class="info-title">
        Shipping Details
      </h3>

      <div class="shipping-details">

        <div class="shipping-person">

          <div class="shipping-avatar">
            <i class="fa-solid fa-location-dot"></i>
          </div>

          <div>

            <strong class="shipping-name">
              <%= order.shippingAddress.fullName %>
            </strong>

            <p class="shipping-phone">
              +91 <%= order.shippingAddress.phone %>
            </p>

          </div>

        </div>

        <div class="shipping-address">

          <p>
            <%= order.shippingAddress.line1 %>
          </p>

          <% if (order.shippingAddress.line2) { %>

            <p>
              <%= order.shippingAddress.line2 %>
            </p>

          <% } %>

          <p>
            <%= order.shippingAddress.city %>,
            <%= order.shippingAddress.state %>
            - <%= order.shippingAddress.pincode %>
          </p>

        </div>

      </div>

    </div>

    <div class="card card-md info-card">

      <h3 class="info-title">
        Order Information
      </h3>

      <div class="order-info-box">

        <div class="info-row">

          <span>
            Items
          </span>

          <strong>
            <%= order.items.length %>
          </strong>

        </div>

        <div class="info-row">

          <span>
            Payment Method
          </span>

          <strong>
            <%= paymentMethodText %>
          </strong>

        </div>

        <div class="info-row">

          <span>
            Payment Status
          </span>

          <strong
            class="payment-status <%= paymentStatusClass %>"
          >
            <%= currentPaymentStatus %>
          </strong>

        </div>

        <div class="info-row">

          <span>
            Order Status
          </span>

          <strong
            class="order-status-text order-status-<%= displayStatusClass %>"
          >
            <%= currentDisplayStatus %>
          </strong>

        </div>

        <% if (
          order.paymentMethod === "Razorpay" &&
          order.razorpayOrderId
        ) { %>

          <div class="info-row">

            <span>
              Payment Reference
            </span>

            <strong class="payment-reference">
              <%= order.razorpayOrderId %>
            </strong>

          </div>

        <% } %>

      </div>

    </div>

  </section>

  <section class="card card-md summary-card">

    <div class="summary-header">

      <h2 class="summary-title">
        Order Summary
      </h2>

      <span class="summary-item-count">
        <%= order.items.length %>
        <%= order.items.length === 1
          ? "Item"
          : "Items" %>
      </span>

    </div>

    <div class="summary-items">

      <% order.items.forEach(item => { %>

        <%
          const itemQuantity =
            Number(item.quantity || 0);

          const itemOriginalAmount =
            Number(
              item.originalUnitPrice ||
              item.unitPrice ||
              0,
            ) * itemQuantity;

          const itemOfferAmount =
            Number(item.unitPrice || 0) *
            itemQuantity;

          const itemCouponDiscount =
            Number(
              item.couponDiscountAmount || 0,
            );

          const itemFinalAmount =
            Math.max(
              itemOfferAmount -
              itemCouponDiscount,
              0,
            );

          const itemOfferDiscount =
            Math.max(
              itemOriginalAmount -
              itemOfferAmount,
              0,
            );

          const itemStatusClass =
            String(
              item.status || "Placed",
            )
              .toLowerCase()
              .replace(/\s+/g,"-");
        %>

        <div
          class="
            summary-item
            <%= item.status === "Cancelled"
              ? "summary-item--cancelled"
              : "" %>
          "
        >

          <img
            src="<%= item.productImage || '/images/no-image.png' %>"
            alt="<%= item.productName %>"
            class="summary-item-image"
          >

          <div class="summary-item-content">

            <div class="item-title-row">

              <h4 class="item-title">
                <%= item.productName %>
              </h4>

              <% if (isPaymentState) { %>

                <span class="item-status-text status-payment-failed">
                  Payment Failed
                </span>

              <% } else { %>

                <span
                  class="item-status-text item-status-<%= itemStatusClass %>"
                >
                  <%= item.status %>
                </span>

              <% } %>

            </div>

            <p class="item-variant">
              <%= item.color %>
              /
              <%= item.size %>
              · Qty <%= item.quantity %>
            </p>

            <% if (isPaymentState) { %>

              <p class="item-meta-text">
                Payment not completed · Item was not confirmed
              </p>

            <% } else if (item.statusMetaText) { %>

              <p class="item-meta-text">
                <%= item.statusMetaText %>
              </p>

            <% } %>

            <% if (item.canReturn) { %>

              <p class="item-return-text">
                Return available ·
                <%= item.returnDaysLeft %>
                day<%= item.returnDaysLeft !== 1
                  ? "s"
                  : "" %>
                left
              </p>

            <% } %>

          </div>

          <div class="summary-item-side">

            <div class="item-price-compact">

              <div class="item-price-main">

                <strong
                  class="
                    item-final-price
                    <%= item.status === "Cancelled"
                      ? "price-cancelled"
                      : "" %>
                  "
                >
                  ₹<%= money(itemFinalAmount) %>
                </strong>

                <% if (
                  itemOriginalAmount >
                  itemFinalAmount
                ) { %>

                  <span class="item-original-price">
                    ₹<%= money(itemOriginalAmount) %>
                  </span>

                <% } %>

              </div>

              <% if (
                itemOfferDiscount > 0 ||
                itemCouponDiscount > 0
              ) { %>

                <div class="item-discount-tags">

                  <% if (itemOfferDiscount > 0) { %>

                    <span class="discount-tag">
                      offer
                      -₹<%= money(itemOfferDiscount) %>
                    </span>

                  <% } %>

                  <% if (itemCouponDiscount > 0) { %>

                    <span class="discount-tag">
                      coupon
                      -₹<%= money(itemCouponDiscount) %>
                    </span>

                  <% } %>

                </div>

              <% } %>

            </div>

            <% if (!isPaymentState) { %>

              <% if (item.canCancel) { %>

                <button
                  type="button"
                  class="secondary-btn cancel-item-btn"
                  data-item-id="<%= item._id %>"
                  data-order-id="<%= order._id %>"
                  data-name="<%= item.productName %>"
                  data-image="<%= item.productImage || '/images/no-image.png' %>"
                  data-size="<%= item.size %>"
                  data-color="<%= item.color %>"
                  data-price="<%= itemFinalAmount %>"
                >
                  Cancel Item
                </button>

              <% } else if (item.canReturn) { %>

                <a
                  href="/user/returns/request/<%= order._id %>/<%= item._id %>"
                  class="secondary-btn return-item-btn"
                >
                  Return Item
                </a>

              <% } else if (item.showReturnStatusBtn) { %>

                <a
                  href="/user/returns/<%= order._id %>/<%= item._id %>"
                  class="secondary-btn return-status-btn"
                >
                  View Return Status
                </a>

              <% } %>

            <% } %>

          </div>

        </div>

      <% }) %>

    </div>

    <div class="summary-divider"></div>

    <div class="order-price-summary">

      <% if (fullyCancelled) { %>

        <div class="summary-row">

          <span>
            Original subtotal
          </span>

          <span>
            ₹<%= money(originalSubtotal) %>
          </span>

        </div>

        <% if (offerDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Offer discount
            </span>

            <span>
              −₹<%= money(offerDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <% if (couponDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Coupon discount

              <% if (order.coupon?.code) { %>
                (<%= order.coupon.code %>)
              <% } %>
            </span>

            <span>
              −₹<%= money(couponDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <div class="summary-row">

          <span>
            Shipping
          </span>

          <span>
            <%= Number(originalShippingFee) === 0
              ? "Free"
              : `₹${money(originalShippingFee)}` %>
          </span>

        </div>

        <div class="summary-divider"></div>

        <div class="summary-row total-row">

          <span>
            Order total
          </span>

          <span>
            ₹<%= money(originalOrderTotal) %>
          </span>

        </div>

        <div class="cancellation-summary">

          <h3 class="cancellation-summary-title">
            Cancellation
          </h3>

          <div class="summary-row summary-cancelled">

            <span>
              Cancelled amount
            </span>

            <span>
              ₹<%= money(originalOrderTotal) %>
            </span>

          </div>

          <% if (refundRequired) { %>

            <div class="summary-row">

              <span>
                Amount paid
              </span>

              <span>
                ₹<%= money(paymentCollected) %>
              </span>

            </div>

            <div class="summary-row cancellation-refund-row">

              <span>
                Refund amount
              </span>

              <strong>
                ₹<%= money(cancellationRefundAmount) %>
              </strong>

            </div>

          <% } else { %>

            <div class="summary-row">

              <span>
                Payment collected
              </span>

              <span>
                ₹0.00
              </span>

            </div>

            <div class="summary-row">

              <span>
                Refund required
              </span>

              <strong>
                No
              </strong>

            </div>

          <% } %>

        </div>

      <% } else if (partiallyCancelled) { %>

        <div class="summary-row">

          <span>
            Original order subtotal
          </span>

          <span>
            ₹<%= money(originalSubtotal) %>
          </span>

        </div>

        <div class="summary-row summary-cancelled">

          <span>
            Cancelled items
          </span>

          <span>
            −₹<%= money(cancelledOriginalAmount) %>
          </span>

        </div>

        <div class="summary-row">

          <span>
            Remaining items subtotal
          </span>

          <span>
            ₹<%= money(activeOriginalSubtotal) %>
          </span>

        </div>

        <% if (activeOfferDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Offer discount
            </span>

            <span>
              −₹<%= money(activeOfferDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <% if (activeCouponDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Coupon discount

              <% if (order.coupon?.code) { %>
                (<%= order.coupon.code %>)
              <% } %>
            </span>

            <span>
              −₹<%= money(activeCouponDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <div class="summary-row">

          <span>
            Remaining subtotal
          </span>

          <span>
            ₹<%= money(activeDiscountedSubtotal) %>
          </span>

        </div>

        <div class="summary-row">

          <span>
            Shipping
          </span>

          <span>
            <%= Number(shippingFee) === 0
              ? "Free"
              : `₹${money(shippingFee)}` %>
          </span>

        </div>

        <div class="summary-row summary-gst">

          <span>
            GST Included
          </span>

          <span>
            ₹<%= money(gstAmount) %>
          </span>

        </div>

        <div class="summary-divider"></div>

        <div class="summary-row total-row">

          <span>
            Current order value
          </span>

          <span>
            ₹<%= money(currentValue) %>
          </span>

        </div>

      <% } else { %>

        <div class="summary-row">

          <span>
            Original subtotal
          </span>

          <span>
            ₹<%= money(originalSubtotal) %>
          </span>

        </div>

        <% if (offerDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Offer discount
            </span>

            <span>
              −₹<%= money(offerDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <% if (couponDiscountTotal > 0) { %>

          <div class="summary-row summary-discount">

            <span>
              Coupon discount

              <% if (order.coupon?.code) { %>
                (<%= order.coupon.code %>)
              <% } %>
            </span>

            <span>
              −₹<%= money(couponDiscountTotal) %>
            </span>

          </div>

        <% } %>

        <div class="summary-row">

          <span>
            Shipping
          </span>

          <span>
            <%= Number(shippingFee) === 0
              ? "Free"
              : `₹${money(shippingFee)}` %>
          </span>

        </div>

        <div class="summary-row summary-gst">

          <span>
            GST Included
          </span>

          <span>
            ₹<%= money(gstAmount) %>
          </span>

        </div>

        <div class="summary-divider"></div>

        <div class="summary-row total-row">

          <span>
            <%= isPaymentState
              ? "Checkout total"
              : "Order total" %>
          </span>

          <span>
            ₹<%= money(currentValue) %>
          </span>

        </div>

      <% } %>

    </div>

  </section>

  <div class="order-actions">

    <% if (canCancelAnyItem) { %>

      <button
        type="button"
        class="secondary-btn cancel-order-btn"
        data-order-id="<%= order._id %>"
      >
        Cancel Order
      </button>

    <% } %>

    <% if (!canReturnToCheckout) { %>

      <a
        href="/user/shop"
        class="primary-btn continue-shopping-btn"
      >
        Continue Shopping
      </a>

    <% } %>

  </div>

  <div
    id="cancelItemModal"
    class="cancel-modal hidden"
  >

    <div class="cancel-modal-content">

      <div class="modal-header">

        <h2>
          Cancel Order
        </h2>

        <button
          type="button"
          id="closeCancelModal"
          class="modal-close"
          aria-label="Close cancellation modal"
        >
          ×
        </button>

      </div>

      <div class="cancel-product">

        <img
          id="modalImage"
          src=""
          alt="Order item"
        >

        <div>

          <h3 id="modalName"></h3>

          <p id="modalColor"></p>

          <p id="modalSize"></p>

          <strong id="modalPrice"></strong>

        </div>

      </div>

      <div class="modal-field">

        <label for="cancelReason">
          Reason
        </label>

        <select
          id="cancelReason"
          class="select-field"
        >

          <option value="">
            Select Reason
          </option>

          <option value="Ordered by mistake">
            Ordered by mistake
          </option>

          <option value="Found better product">
            Found better product
          </option>

          <option value="Delivery taking too long">
            Delivery taking too long
          </option>

          <option value="Changed my mind">
            Changed my mind
          </option>

        </select>

      </div>

      <div class="modal-field">

        <label for="cancelComment">
          Comments
        </label>

        <textarea
          id="cancelComment"
          class="input-field cancel-comment"
          placeholder="Additional comments"
        ></textarea>

      </div>

      <div class="cancel-modal-actions">

        <button
          type="button"
          id="keepItemBtn"
          class="secondary-btn"
        >
          Keep Order
        </button>

        <button
          type="button"
          id="confirmCancelItem"
          class="primary-btn"
        >
          Confirm Cancellation
        </button>

      </div>

    </div>

  </div>

</main>

<%- include("../partials/user-scripts") %>

<script src="/js/user/orderDetail.js"></script>

</body>

</html>