<!DOCTYPE html>
<html lang="en">
<head>
  <title>Order Details — Commoncore</title>

  <%- include("../partials/user-head") %>

  <link
    rel="stylesheet"
    href="/css/user/order-detail.css"
  >
</head>

<body>

<%- include("../partials/user-header") %>

<main class="order-detail-page">

  <%
    const currentDisplayStatus =
      displayStatus ||
      order.orderStatus ||
      "Placed";

    const displayStatusClass =
      String(currentDisplayStatus)
        .toLowerCase()
        .trim()
        .replace(/\s+/g, "-");

    const currentPaymentStatus =
      paymentExpired
        ? "Expired"
        : paymentFailed
          ? "Failed"
          : order.paymentStatus;

    const paymentStatusClass =
      String(currentPaymentStatus)
        .toLowerCase()
        .trim()
        .replace(/\s+/g, "-");

    const money = (value) =>
      Number(value || 0).toLocaleString(
        "en-IN",
        {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        },
      );
  %>

  <section class="order-header card card-md">

    <div>
      <h1 class="order-number">
        <%= order.orderNumber %>
      </h1>

      <p class="order-date">
        <%= isRazorpayPending
          ? "Created on"
          : "Placed on" %>

        <%= new Date(
          order.createdAt,
        ).toLocaleDateString(
          "en-IN",
          {
            day: "numeric",
            month: "long",
            year: "numeric",
          },
        ) %>
      </p>
    </div>

    <div class="order-header-right">

      <span
        class="status-badge status-<%= displayStatusClass %>"
      >
        <%= currentDisplayStatus %>
      </span>

      <% if (canDownloadInvoice) { %>
        <a
          href="/user/order/<%= order._id %>/invoice"
          class="invoice-btn"
        >
          Download Invoice
        </a>
      <% } %>

    </div>

  </section>

  <% if (isRazorpayPending) { %>

    <section
      class="
        payment-pending-card
        card
        card-md
        <%= paymentExpired
          ? 'payment-pending-card--expired'
          : paymentFailed
            ? 'payment-pending-card--failed'
            : '' %>
      "
    >

      <div class="payment-pending-content">

        <div class="payment-pending-icon">
          <% if (paymentExpired) { %>
            ×
          <% } else if (paymentFailed) { %>
            !
          <% } else { %>
            ₹
          <% } %>
        </div>

        <div class="payment-pending-text">

          <h2>
            <% if (paymentExpired) { %>
              Payment session expired
            <% } else if (paymentFailed) { %>
              Payment was unsuccessful
            <% } else { %>
              Complete your payment
            <% } %>
          </h2>

          <p>
            <% if (paymentExpired) { %>
              The payment window for this order has expired.
              This order has not been confirmed.
            <% } else if (paymentFailed) { %>
              Your previous payment attempt was unsuccessful.
              Retry the payment to confirm this order.
            <% } else { %>
              Your order has been created, but payment is still
              pending. Complete the payment to confirm the order.
            <% } %>
          </p>

          <% if (
            paymentFailed &&
            order.paymentFailure?.description
          ) { %>

            <p class="payment-failure-reason">
              <%= order.paymentFailure.description %>
            </p>

          <% } %>

        </div>

      </div>

      <% if (canRetryPayment) { %>

        <button
          type="button"
          id="retryPaymentBtn"
          class="primary-btn retry-payment-btn"
          data-order-id="<%= order._id %>"
        >
          Retry Payment
        </button>

      <% } %>

    </section>

  <% } %>

  <section class="info-grid">

    <div class="card card-md">

      <h3 class="info-title">
        Shipping Details
      </h3>

      <div class="shipping-box">

        <h4>
          <%= order.shippingAddress.fullName %>
        </h4>

        <p>
          <%= order.shippingAddress.line1 %>
        </p>

        <% if (order.shippingAddress.line2) { %>
          <p>
            <%= order.shippingAddress.line2 %>
          </p>
        <% } %>

        <p>
          <%= order.shippingAddress.city %>,
          <%= order.shippingAddress.state %>
        </p>

        <p>
          <%= order.shippingAddress.pincode %>
        </p>

        <p>
          +91 <%= order.shippingAddress.phone %>
        </p>

      </div>

    </div>

    <div class="card card-md">

      <h3 class="info-title">
        Order Information
      </h3>

      <div class="order-info-box">

        <div class="info-row">
          <span>Items</span>
          <p>
            <%= order.items.length %>
          </p>
        </div>

        <div class="info-row">
          <span>Payment Method</span>

          <strong>
            <%= order.paymentMethod ===
              "CashOnDelivery"
                ? "Cash On Delivery"
                : order.paymentMethod.replace(
                    /([a-z])([A-Z])/g,
                    "$1 $2",
                  ) %>
          </strong>
        </div>

        <div class="info-row">
          <span>Payment Status</span>

          <strong
            class="payment-status <%= paymentStatusClass %>"
          >
            <%= currentPaymentStatus %>
          </strong>
        </div>

        <div class="info-row">
          <span>Order Status</span>

          <strong
            class="order-status-text status-<%= displayStatusClass %>"
          >
            <%= currentDisplayStatus %>
          </strong>
        </div>

        <% if (
          order.paymentMethod === "Razorpay" &&
          order.razorpayOrderId
        ) { %>

          <div class="info-row">
            <span>Payment Reference</span>

            <strong class="payment-reference">
              <%= order.razorpayOrderId %>
            </strong>
          </div>

        <% } %>

      </div>

    </div>

  </section>

  <section class="card card-md summary-card">

    <h2 class="summary-title">
      Order Summary
    </h2>

    <% order.items.forEach((item) => { %>

      <%
        const itemOfferAmount =
          Number(item.unitPrice || 0) *
          Number(item.quantity || 0);

        const itemCouponDiscount =
          Number(
            item.couponDiscountAmount || 0,
          );

        const itemFinalAmount =
          Math.max(
            itemOfferAmount -
            itemCouponDiscount,
            0,
          );

        const itemStatusClass =
          String(item.status || "Placed")
            .toLowerCase()
            .replace(/\s+/g, "-");
      %>

      <div
        class="
          summary-item
          <%= item.status === "Cancelled"
            ? "summary-item--cancelled"
            : "" %>
        "
      >

        <img
          src="<%= item.productImage || '/images/no-image.png' %>"
          alt="<%= item.productName %>"
        >

        <div class="summary-item-content">

          <div class="item-top-row">

            <h4 class="item-title">

              <%= item.productName %>

              <% if (isRazorpayPending) { %>

                <span
                  class="item-status-text status-<%= displayStatusClass %>"
                >
                  <%= currentDisplayStatus %>
                </span>

              <% } else { %>

                <span
                  class="item-status-text item-status-<%= itemStatusClass %>"
                >
                  <%= item.status %>
                </span>

              <% } %>

            </h4>

          </div>

          <p class="item-variant">
            <%= item.color %> /
            <%= item.size %>
            · Qty <%= item.quantity %>
          </p>

          <% if (isRazorpayPending) { %>

            <p class="item-meta-text">
              <%= paymentExpired
                ? "Payment expired. This item was not confirmed."
                : paymentFailed
                  ? "Payment failed. Retry payment to confirm this item."
                  : "Item will be confirmed after successful payment." %>
            </p>

          <% } else if (item.statusMetaText) { %>

            <p class="item-meta-text">
              <%= item.statusMetaText %>
            </p>

          <% } %>

          <% if (item.canReturn) { %>

            <p class="item-return-text">
              Return available ·
              <%= item.returnDaysLeft %>
              day<%= item.returnDaysLeft !== 1
                ? "s"
                : "" %>
              left
            </p>

          <% } %>

        </div>

        <div class="summary-item-right">

          <div class="item-price-breakdown">

            <div class="item-unit-price-row">

              <span class="unit-price">
                ₹<%= money(item.unitPrice) %>
                × <%= item.quantity %>
              </span>

              <% if (
                item.offerId &&
                Number(item.originalUnitPrice) >
                Number(item.unitPrice)
              ) { %>

                <span class="item-old-unit-price">
                  ₹<%= money(item.originalUnitPrice) %>
                </span>

                <% if (item.offerId) { %>

                  <span class="item-offer-badge">

                    <% if (
                      item.discountType === "PERCENTAGE"
                    ) { %>

                      <%= Number(item.discountValue) %>% OFF

                    <% } else { %>

                      ₹<%= Number(
                        item.discountValue,
                      ).toLocaleString("en-IN") %> OFF

                    <% } %>

                  </span>

                <% } %>

              <% } %>

            </div>

            <% if (itemCouponDiscount > 0) { %>

              <div class="item-coupon-discount">

                <span>
                  Coupon discount
                </span>

                <strong>
                  −₹<%= money(itemCouponDiscount) %>
                </strong>

              </div>

            <% } %>

            <div class="item-line-price-row">

              <strong
                class="item-final-price <%= item.status === 'Cancelled'
                  ? 'price-cancelled'
                  : '' %>"
              >
                ₹<%= money(itemFinalAmount) %>
              </strong>

            </div>

          </div>

          <% if (!isRazorpayPending) { %>

            <div class="item-actions">

              <% if (item.canCancel) { %>

                <button
                  type="button"
                  class="secondary-btn cancel-item-btn"
                  data-item-id="<%= item._id %>"
                  data-order-id="<%= order._id %>"
                  data-name="<%= item.productName %>"
                  data-image="<%= item.productImage || '/images/no-image.png' %>"
                  data-size="<%= item.size %>"
                  data-color="<%= item.color %>"
                  data-price="<%= itemFinalAmount %>"
                >
                  Cancel Item
                </button>

              <% } %>

              <% if (item.canReturn) { %>

                <a
                  href="/user/returns/request/<%= order._id %>/<%= item._id %>"
                  class="secondary-btn return-item-btn"
                >
                  Return Item
                </a>

              <% } else if (item.showReturnStatusBtn) { %>

                <a
                  href="/user/returns/<%= order._id %>/<%= item._id %>"
                  class="secondary-btn return-status-btn"
                >
                  View Return Status
                </a>

              <% } %>

              <% if (item.canReview) { %>

                <button
                  type="button"
                  class="secondary-btn write-review-btn"
                  data-product-id="<%= item.productId %>"
                  data-product-name="<%= item.productName %>"
                  data-product-image="<%= item.productImage || '/images/no-image.png' %>"
                >
                  <i class="fa-regular fa-star"></i>
                  Write Review
                </button>

              <% } else if (item.hasReview) { %>

                <a
                  href="/user/product/<%= item.productId %>#reviews"
                  class="secondary-btn view-review-btn"
                >
                  <i class="fa-regular fa-star"></i>
                  Your Review
                </a>

              <% } %>

            </div>

          <% } %>

        </div>

      </div>

    <% }) %>

    <div class="summary-divider"></div>

    <% if (fullyCancelled) { %>

      <div class="summary-row">
        <span>Original subtotal</span>
        <span>
          ₹<%= money(originalSubtotal) %>
        </span>
      </div>

      <% if (offerDiscountTotal > 0) { %>

        <div class="summary-row summary-discount">
          <span>Offer discount</span>

          <span>
            −₹<%= money(
              offerDiscountTotal,
            ) %>
          </span>
        </div>

      <% } %>

      <div class="summary-row">
        <span>Subtotal</span>
        <span>
          ₹<%= money(subtotal) %>
        </span>
      </div>

      <% if (couponDiscountTotal > 0) { %>

        <div class="summary-row summary-discount">

          <span>
            Coupon discount

            <% if (order.coupon?.code) { %>
              (<%= order.coupon.code %>)
            <% } %>
          </span>

          <span>
            −₹<%= money(
              couponDiscountTotal,
            ) %>
          </span>

        </div>

      <% } %>

      <div class="summary-row">

        <span>Shipping</span>

        <span>
          <%= Number(originalShippingFee) === 0
            ? "Free"
            : `₹${money(
                originalShippingFee,
              )}` %>
        </span>

      </div>

      <div class="summary-divider"></div>

      <div class="summary-row total-row">
        <span>Order total</span>

        <span>
          ₹<%= money(
            originalOrderTotal,
          ) %>
        </span>
      </div>

      <div class="cancellation-summary">

        <h3 class="cancellation-summary-title">
          Cancellation
        </h3>

        <div class="summary-row summary-cancelled">

          <span>
            Cancelled amount
          </span>

          <span>
            ₹<%= money(
              originalOrderTotal,
            ) %>
          </span>

        </div>

        <% if (refundRequired) { %>

          <div class="summary-row">
            <span>Amount paid</span>

            <span>
              ₹<%= money(
                paymentCollected,
              ) %>
            </span>
          </div>

          <div class="summary-row cancellation-refund-row">

            <span>Refund amount</span>

            <strong>
              ₹<%= money(
                cancellationRefundAmount,
              ) %>
            </strong>

          </div>

        <% } else { %>

          <div class="summary-row">
            <span>
              Payment collected
            </span>

            <span>₹0.00</span>
          </div>

          <div class="summary-row">
            <span>
              Refund required
            </span>

            <strong>No</strong>
          </div>

        <% } %>

      </div>

    <% } else if (partiallyCancelled) { %>

      <div class="summary-row">

        <span>
          Original order subtotal
        </span>

        <span>
          ₹<%= money(
            originalSubtotal,
          ) %>
        </span>

      </div>

      <div class="summary-row summary-cancelled">

        <span>
          Cancelled items
        </span>

        <span>
          −₹<%= money(
            cancelledOriginalAmount,
          ) %>
        </span>

      </div>

      <div class="summary-row">

        <span>
          Remaining items subtotal
        </span>

        <span>
          ₹<%= money(
            activeOriginalSubtotal,
          ) %>
        </span>

      </div>

      <% if (
        activeOfferDiscountTotal > 0
      ) { %>

        <div class="summary-row summary-discount">

          <span>
            Offer discount
          </span>

          <span>
            −₹<%= money(
              activeOfferDiscountTotal,
            ) %>
          </span>

        </div>

      <% } %>

      <% if (
        activeCouponDiscountTotal > 0
      ) { %>

        <div class="summary-row summary-discount">

          <span>
            Coupon discount

            <% if (order.coupon?.code) { %>
              (<%= order.coupon.code %>)
            <% } %>
          </span>

          <span>
            −₹<%= money(
              activeCouponDiscountTotal,
            ) %>
          </span>

        </div>

      <% } %>

      <div class="summary-row">

        <span>
          Remaining subtotal
        </span>

        <span>
          ₹<%= money(
            activeDiscountedSubtotal,
          ) %>
        </span>

      </div>

      <div class="summary-row">

        <span>Shipping</span>

        <span>
          <%= Number(shippingFee) === 0
            ? "Free"
            : `₹${money(
                shippingFee,
              )}` %>
        </span>

      </div>

      <div class="summary-row summary-gst">

        <span>
          GST Included
        </span>

        <span>
          ₹<%= money(gstAmount) %>
        </span>

      </div>

      <div class="summary-row">

        <span>Payment</span>

        <span>
          <%= order.paymentMethod ===
            "CashOnDelivery"
              ? "Cash On Delivery"
              : order.paymentMethod.replace(
                  /([a-z])([A-Z])/g,
                  "$1 $2",
                ) %>
        </span>

      </div>

      <div class="summary-divider"></div>

      <div class="summary-row total-row">

        <span>
          Current order value
        </span>

        <span>
          ₹<%= money(
            currentValue,
          ) %>
        </span>

      </div>

    <% } else { %>

      <div class="summary-row">

        <span>
          Original subtotal
        </span>

        <span>
          ₹<%= money(
            originalSubtotal,
          ) %>
        </span>

      </div>

      <% if (offerDiscountTotal > 0) { %>

        <div class="summary-row summary-discount">

          <span>
            Offer discount
          </span>

          <span>
            −₹<%= money(
              offerDiscountTotal,
            ) %>
          </span>

        </div>

      <% } %>

      <div class="summary-row">

        <span>
          Subtotal
        </span>

        <span>
          ₹<%= money(subtotal) %>
        </span>

      </div>

      <% if (couponDiscountTotal > 0) { %>

        <div class="summary-row summary-discount">

          <span>
            Coupon discount

            <% if (order.coupon?.code) { %>
              (<%= order.coupon.code %>)
            <% } %>
          </span>

          <span>
            −₹<%= money(
              couponDiscountTotal,
            ) %>
          </span>

        </div>

        <div class="summary-row">

          <span>
            Discounted subtotal
          </span>

          <span>
            ₹<%= money(
              discountedSubtotal,
            ) %>
          </span>

        </div>

      <% } %>

      <div class="summary-row">

        <span>
          Shipping
        </span>

        <span>
          <%= Number(shippingFee) === 0
            ? "Free"
            : `₹${money(
                shippingFee,
              )}` %>
        </span>

      </div>

      <div class="summary-row summary-gst">

        <span>
          GST Included
        </span>

        <span>
          ₹<%= money(gstAmount) %>
        </span>

      </div>

      <div class="summary-row">

        <span>Payment</span>

        <span>
          <%= order.paymentMethod ===
            "CashOnDelivery"
              ? "Cash On Delivery"
              : order.paymentMethod.replace(
                  /([a-z])([A-Z])/g,
                  "$1 $2",
                ) %>
        </span>

      </div>

      <div class="summary-divider"></div>

      <div class="summary-row total-row">

        <span>
          Order total
        </span>

        <span>
          ₹<%= money(
            currentValue,
          ) %>
        </span>

      </div>

      <% if (isRazorpayPending) { %>

        <p
          class="
            summary-payment-note
            <%= paymentExpired
              ? 'summary-payment-note--expired'
              : paymentFailed
                ? 'summary-payment-note--failed'
                : '' %>
          "
        >
          <%= paymentExpired
            ? "The payment session has expired. This order was not confirmed."
            : paymentFailed
              ? "The payment attempt failed. Retry payment to confirm this order."
              : "Payment is required before this order can be confirmed." %>
        </p>

      <% } %>

    <% } %>

  </section>

  <% if (showEstimatedDelivery) { %>

    <section class="delivery-card card card-md">

      <div>

        <span class="delivery-label">
          Expected Delivery
        </span>

        <strong>
          <%= order.estimatedDeliveryDate
            ? new Date(
                order.estimatedDeliveryDate,
              ).toLocaleDateString(
                "en-IN",
                {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                },
              )
            : "To be updated" %>
        </strong>

      </div>

    </section>

  <% } %>

  <div class="order-actions">

    <% if (canCancelAnyItem) { %>

      <button
        type="button"
        class="secondary-btn cancel-order-btn"
        data-order-id="<%= order._id %>"
      >
        Cancel Order
      </button>

    <% } %>

    <% if (canRetryPayment) { %>

      <button
        type="button"
        class="primary-btn retry-payment-btn order-action-retry-btn"
        data-order-id="<%= order._id %>"
        onclick="document.getElementById('retryPaymentBtn')?.click()"
      >
        Retry Payment
      </button>

    <% } %>

    <a
      href="/user/shop"
      class="<%= canRetryPayment
        ? 'secondary-btn'
        : 'primary-btn' %> continue-shopping-btn"
    >
      Continue Shopping
    </a>

  </div>

  <div
    id="cancelItemModal"
    class="cancel-modal hidden"
  >

    <div class="cancel-modal-content">

      <div class="modal-header">

        <h2>
          Cancel Order
        </h2>

        <button
          type="button"
          id="closeCancelModal"
          class="modal-close"
          aria-label="Close cancellation modal"
        >
          ×
        </button>

      </div>

      <div class="cancel-product">

        <img
          id="modalImage"
          src=""
          alt="Order item"
        >

        <div>
          <h3 id="modalName"></h3>
          <p id="modalColor"></p>
          <p id="modalSize"></p>
          <strong id="modalPrice"></strong>
        </div>

      </div>

      <div class="modal-field">

        <label for="cancelReason">
          Reason
        </label>

        <select
          id="cancelReason"
          class="select-field"
        >

          <option value="">
            Select Reason
          </option>

          <option value="Ordered by mistake">
            Ordered by mistake
          </option>

          <option value="Found better product">
            Found better product
          </option>

          <option value="Delivery taking too long">
            Delivery taking too long
          </option>

          <option value="Changed my mind">
            Changed my mind
          </option>

        </select>

      </div>

      <div class="modal-field">

        <label for="cancelComment">
          Comments
        </label>

        <textarea
          id="cancelComment"
          class="input-field cancel-comment"
          placeholder="Additional comments"
        ></textarea>

      </div>

      <div class="cancel-modal-actions">

        <button
          type="button"
          id="keepItemBtn"
          class="secondary-btn"
        >
          Keep Order
        </button>

        <button
          type="button"
          id="confirmCancelItem"
          class="primary-btn"
        >
          Confirm Cancellation
        </button>

      </div>

    </div>

  </div>

<div
  id="reviewModal"
  class="review-modal hidden"
>
  <div class="review-modal-content">

    <div class="modal-header">

      <div>
        <h2>Write a Review</h2>

        <p class="review-modal-subtitle">
          Share your experience with this product.
        </p>
      </div>

      <button
        type="button"
        id="closeReviewModal"
        class="modal-close"
        aria-label="Close review modal"
      >
        ×
      </button>

    </div>

    <div class="review-product">

      <img
        id="reviewProductImage"
        src="/images/no-image.png"
        alt="Product"
      >

      <div>

        <span class="review-product-label">
          REVIEWING
        </span>

        <h3 id="reviewProductName">
          Product
        </h3>

        <p>
          Your review will appear on the product page.
        </p>

      </div>

    </div>

    <div class="review-field">

      <label>
        Your Rating
      </label>

      <div
        id="reviewStars"
        class="review-stars"
        role="radiogroup"
        aria-label="Product rating"
      >

        <% for (
          let rating = 1;
          rating <= 5;
          rating++
        ) { %>

          <button
            type="button"
            class="review-star"
            data-rating="<%= rating %>"
            aria-label="<%= rating %> star<%= rating > 1 ? 's' : '' %>"
          >
            <i class="fa-regular fa-star"></i>
          </button>

        <% } %>

      </div>

      <p
        id="reviewRatingText"
        class="review-rating-text"
      >
        Select a rating
      </p>

      <p
        id="reviewRatingError"
        class="review-field-error"
      ></p>

    </div>

    <div class="review-field">

      <div class="review-label-row">

        <label for="reviewComment">
          Your Review
        </label>

        <span id="reviewCharacterCount">
          0 / 500
        </span>

      </div>

      <textarea
        id="reviewComment"
        class="review-comment"
        maxlength="500"
        placeholder="What did you like about this product?"
      ></textarea>

      <p
        id="reviewCommentError"
        class="review-field-error"
      ></p>

    </div>

    <p
      id="reviewFormError"
      class="review-form-error"
    ></p>

    <div class="review-modal-actions">

      <button
        type="button"
        id="cancelReviewBtn"
        class="secondary-btn"
      >
        Cancel
      </button>

      <button
        type="button"
        id="submitReviewBtn"
        class="primary-btn"
      >
        Submit Review
      </button>

    </div>

  </div>
</div>

</main>

<%- include("../partials/user-scripts") %>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/user/orderDetail.js"></script>

</body>
</html>