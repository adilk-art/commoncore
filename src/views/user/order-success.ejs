<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    Order Successful — Commoncore
  </title>

  <%- include('../partials/user-head') %>

  <link
    rel="stylesheet"
    href="/css/user/order-success.css"
  >

</head>

<body>

<%- include('../partials/user-header') %>

<main class="success-page">

  <!-- SUCCESS HERO -->

  <section class="success-hero card card-lg">

    <div class="success-icon">
      ✓
    </div>

    <h1 class="success-title">
      Order Placed Successfully
    </h1>

    <p class="success-text">
      Thank you for shopping with Commoncore.
      Your order has been placed successfully.
    </p>

    <div class="success-meta">

      <div class="success-meta-item">

        <span>
          Order ID
        </span>

        <strong>
          <%= order.orderNumber %>
        </strong>

      </div>

      <div class="success-meta-item">

        <span>
          Order Date
        </span>

        <strong>
          <%= new Date(order.createdAt)
            .toLocaleDateString("en-IN") %>
        </strong>

      </div>

    </div>

  </section>

  <!-- TOP INFO -->

  <div class="success-top-grid">

    <!-- ADDRESS -->

    <section class="success-card card card-md">

      <div class="success-card-head">

        <h3 class="text-card-title">
          Shipping Address
        </h3>

      </div>

      <div class="success-address">

        <h4>
          <%= order.shippingAddress.fullName %>
        </h4>

        <p>
          <%= order.shippingAddress.line1 %>
        </p>

        <% if(order.shippingAddress.line2){ %>

          <p>
            <%= order.shippingAddress.line2 %>
          </p>

        <% } %>

        <p>
          <%= order.shippingAddress.city %>,
          <%= order.shippingAddress.state %>
        </p>

        <p>
          <%= order.shippingAddress.pincode %>
        </p>

        <span>
          +91 <%= order.shippingAddress.phone %>
        </span>

      </div>

    </section>

    <!-- DELIVERY -->

    <section class="success-card card card-md">

      <div class="success-card-head">

        <h3 class="text-card-title">
          Delivery
        </h3>

      </div>

     <div class="delivery-info">

  <div class="delivery-row">
    <span>Estimated Delivery</span>
    <strong>
      <%= new Date(order.estimatedDeliveryDate).toLocaleDateString("en-IN", {
        day: "numeric",
        month: "long",
        year: "numeric"
      }) %>
    </strong>
  </div>

  <div class="delivery-row">
    <span>Payment Method</span>
    <strong>
      <%= order.paymentMethod.replace(/([a-z])([A-Z])/g, "$1 $2") %>
    </strong>
  </div>

  <div class="delivery-row">
    <span>Order Status</span>
    <strong>
      <%= order.orderStatus %>
    </strong>
  </div>

</div>

    </section>

  </div>

  <!-- ORDER DETAILS -->

  <section class="success-order-card card card-lg">

    <div class="success-order-head">

      <h2 class="text-section-title">
        Ordered Items
      </h2>

      <span class="success-order-count">
        <%= order.items.length %> Items
      </span>

    </div>

    <div class="success-items">

      <% order.items.forEach(item => { %>

        <div class="success-item">

          <img
            src="<%= item.variantId?.images?.[0]?.url %>"
            alt=""
          >

          <div class="success-item-info">

            <h4>
              <%= item.productName %>
            </h4>

            <p>
              <%= item.color %> /
              <%= item.size %>
            </p>

            <span>
              Qty:
              <%= item.quantity %>
            </span>

          </div>

<div class="success-item-price">

  <div class="success-item-price-row">

    <span class="success-item-current-price">
      ₹<%= Number(
        item.unitPrice * item.quantity
      ).toLocaleString("en-IN") %>
    </span>

    <% if (item.hasOffer) { %>
      <span class="success-item-old-price">
        ₹<%= Number(
          (item.originalUnitPrice ?? item.unitPrice) *
          item.quantity
        ).toLocaleString("en-IN") %>
      </span>
    <% } %>

  </div>

  <% if (item.hasOffer) { %>
    <span class="success-item-offer-badge">
      <% if (item.discountType === "PERCENTAGE") { %>
        <%= Number(item.discountValue) %>% OFF
      <% } else { %>
        ₹<%= Number(
          item.discountValue
        ).toLocaleString("en-IN") %> OFF
      <% } %>
    </span>
  <% } %>

</div>

        </div>

      <% }) %>

    </div>

    <div class="summary-divider"></div>

    <!-- PRICE SUMMARY -->

<div class="success-summary">

  <div class="summary-row">
    <span>Original subtotal</span>

    <span>
      ₹<%= Number(
        originalSubtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <% if (discountTotal > 0) { %>
    <div class="summary-row summary-row--discount">
      <span>Offer discount</span>

      <span>
        −₹<%= Number(
          discountTotal
        ).toLocaleString("en-IN") %>
      </span>
    </div>
  <% } %>

  <div class="summary-row">
    <span>Subtotal</span>

    <span>
      ₹<%= Number(
        order.subtotal
      ).toLocaleString("en-IN") %>
    </span>
  </div>

  <div class="summary-row summary-row--gst">
    <span>GST Included</span>

    <span>
      ₹<%= Number(
        gstAmount
      ).toFixed(2) %>
    </span>
  </div>

  <div class="summary-row">
    <span>Shipping</span>

    <span>
      <%= order.shippingFee === 0
        ? "Free"
        : `₹${Number(
            order.shippingFee
          ).toLocaleString("en-IN")}` %>
    </span>
  </div>

  <div class="summary-divider"></div>

  <div class="summary-row summary-total">

    <span>
      Total

      <span class="text-muted gst-note">
        Inclusive of GST
      </span>
    </span>

    <span>
      ₹<%= Number(
        order.total
      ).toLocaleString("en-IN") %>
    </span>

  </div>

</div>

  </section>

  <!-- ACTIONS -->

  <div class="success-actions">

    <a
    href="/user/order/<%= order._id %>"
    class="primary-btn"
  >
    View Order
  </a>


    <a
      href="/user/shop"
      class="secondary-btn"
    >
      Continue Shopping
    </a>

  </div>

</main>

<%- include('../partials/user-scripts') %>

</body>
</html>