<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Address Book</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >

  <link rel="stylesheet" href="/css/user/standard.css">
  <link rel="stylesheet" href="/css/user/style.css">
  <link rel="stylesheet" href="/css/user/address.css">
  <link rel="stylesheet" href="/css/user/toast.css">
  <link rel="stylesheet" href="/css/user/user-header.css">

</head>

<body>

  <%- include("../partials/user-header") %>
  <%- include("../partials/user-logout-modal") %>

  <div class="account-container">

    <%- include("../partials/sidebar", { active: "address" }) %>

    <div class="main-content">

      <div class="address-page-header">

        <div class="address-heading">

<h2 class="page-title">ADDRESS BOOK</h2>
<p class="page-subtitle">Manage your delivery addresses</p>

        </div>

        <button
          type="button"
          class="add-address-btn"
          id="addAddressBtn"
        >
          <i class="fa-solid fa-plus"></i>
          Add Address
        </button>

      </div>

      <% if (typeof error !== "undefined") { %>

        <p class="page-error">
          <%= error %>
        </p>

      <% } %>

      <% if (addresses.length === 0) { %>

        <div class="address-empty">

          <div class="empty-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>

          <h3>
            No addresses yet
          </h3>

          <p>
            Add a delivery address to make your checkout faster.
          </p>

          <button
            type="button"
            class="empty-add-btn"
            id="addAddressBtnEmpty"
          >
            <i class="fa-solid fa-plus"></i>
            Add Your First Address
          </button>

        </div>

      <% } else { %>

        <div class="address-list">

          <% addresses.forEach(addr => { %>

            <div class="address-card">

              <div class="address-card-top">

                <div class="address-user-icon">
                  <i class="fa-regular fa-user"></i>
                </div>

                <% if (addr.isDefault) { %>

                  <span class="default-tag">
                    <i class="fa-solid fa-star"></i>
                    Default
                  </span>

                <% } %>

              </div>

              <div class="address-details">

                <h3>
                  <%= addr.fullName %>
                </h3>

                <p class="address-text">

                  <%= addr.line1 %>

                  <% if (addr.line2) { %>
                    , <%= addr.line2 %>
                  <% } %>

                  <br>

                  <%= addr.city %>,
                  <%= addr.state %> -
                  <%= addr.pincode %>

                </p>

                <p class="address-phone">
                  <i class="fa-solid fa-phone"></i>
                  +91 <%= addr.phone %>
                </p>

              </div>

              <div class="address-actions">

                <button
                  type="button"
                  class="address-action editAddressBtn"
                  data-id="<%= addr._id %>"
                  data-fullname="<%= addr.fullName %>"
                  data-phone="<%= addr.phone %>"
                  data-line1="<%= addr.line1 %>"
                  data-line2="<%= addr.line2 || '' %>"
                  data-city="<%= addr.city %>"
                  data-state="<%= addr.state %>"
                  data-pincode="<%= addr.pincode %>"
                  data-default="<%= addr.isDefault %>"
                >
                  <i class="fa-regular fa-pen-to-square"></i>
                  Edit
                </button>

                <button
                  type="button"
                  class="address-action delete-action"
                  onclick="openDeleteModal('<%= addr._id %>')"
                >
                  <i class="fa-regular fa-trash-can"></i>
                  Delete
                </button>

                <% if (!addr.isDefault) { %>

                  <button
                    type="button"
                    class="address-action default-action"
                    onclick="setDefault('<%= addr._id %>', this)"
                  >
                    <i class="fa-regular fa-circle-check"></i>
                    Set Default
                  </button>

                <% } %>

              </div>

            </div>

          <% }) %>

        </div>

      <% } %>

    </div>

  </div>

  <div
    class="address-modal"
    id="addressModal"
  >

    <div class="address-modal-box">

      <div class="address-modal-header">

        <div>

          <h3 id="addressModalTitle">
            Add New Address
          </h3>

          <p>
            Enter your delivery address details
          </p>

        </div>

        <button
          type="button"
          class="modal-close-btn"
          id="closeAddressModal"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>

      </div>

      <form id="addressForm">

        <input
          type="hidden"
          name="addressId"
          id="addressId"
        >

        <div class="address-form-grid">

          <div class="address-field">

            <label>
              Full Name
            </label>

            <input
              type="text"
              name="fullName"
              placeholder="Enter full name"
            >

            <span
              class="error-msg"
              id="fullNameError"
            ></span>

          </div>

          <div class="address-field">

            <label>
              Phone Number
            </label>

            <input
              type="text"
              name="phone"
              placeholder="10-digit phone number"
              maxlength="10"
            >

            <span
              class="error-msg"
              id="phoneError"
            ></span>

          </div>

          <div class="address-field full-field">

            <label>
              Address
            </label>

            <input
              type="text"
              name="line1"
              placeholder="House / Street / Area"
            >

            <span
              class="error-msg"
              id="line1Error"
            ></span>

          </div>

          <div class="address-field">

            <label>
              Landmark
              <span>(Optional)</span>
            </label>

            <input
              type="text"
              name="line2"
              placeholder="Nearby landmark"
            >

          </div>

          <div class="address-field">

            <label>
              Pincode
            </label>

            <input
              type="text"
              name="pincode"
              placeholder="6-digit pincode"
              maxlength="6"
            >

            <span
              class="error-msg"
              id="pincodeError"
            ></span>

          </div>

          <div class="address-field">

            <label>
              City
            </label>

            <input
              type="text"
              name="city"
              placeholder="City"
            >

            <span
              class="error-msg"
              id="cityError"
            ></span>

          </div>

          <div class="address-field">

            <label>
              State
            </label>

            <input
              type="text"
              name="state"
              placeholder="State"
            >

            <span
              class="error-msg"
              id="stateError"
            ></span>

          </div>

        </div>

        <label class="default-check">

          <input
            type="checkbox"
            name="isDefault"
          >

          <span>
            Set as default address
          </span>

        </label>

        <div class="address-modal-actions">

          <button
            type="button"
            class="modal-cancel-btn"
            id="cancelAddressBtn"
          >
            Cancel
          </button>

          <button
            type="submit"
            class="modal-save-btn"
            id="saveAddressBtn"
          >
            Save Address
          </button>

        </div>

      </form>

    </div>

  </div>

  <div
    class="confirm-modal"
    id="deleteModal"
  >

    <div class="confirm-modal-box">

      <div class="confirm-icon delete-icon">
        <i class="fa-regular fa-trash-can"></i>
      </div>

      <h3>
        Delete Address?
      </h3>

      <p>
        Are you sure you want to delete this address?
        This action cannot be undone.
      </p>

      <div class="confirm-actions">

        <button
          type="button"
          class="confirm-cancel-btn"
          onclick="closeDeleteModal()"
        >
          Cancel
        </button>

        <button
          type="button"
          class="confirm-delete-btn"
          id="confirmDeleteBtn"
          onclick="confirmDelete()"
        >
          Delete Address
        </button>

      </div>

    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/user/logout.js"></script>
  <script src="/js/user/address.js"></script>
  <script src="/js/utils/toast.js"></script>

</body>

</html>