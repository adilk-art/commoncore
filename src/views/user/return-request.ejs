<!DOCTYPE html>
<html lang="en">

<head>
  <title>Return Item — Commoncore</title>

  <%- include("../partials/user-head") %>

  <link
    rel="stylesheet"
    href="/css/user/return-request.css"
  >
</head>

<body>

<%- include("../partials/user-header") %>

<main class="return-page">

  <div class="return-top">

    <a
      href="/user/order/<%= order._id %>"
      class="return-back"
    >
      ← Back to Order Details
    </a>

    <div class="return-heading">

      <span class="return-eyebrow">
        RETURN REQUEST
      </span>

      <h1 class="page-title">
        Return Item
      </h1>

      <p class="return-page-subtitle">
        Select a reason, confirm the pickup address and submit your return request.
      </p>

    </div>

  </div>

  <section class="card card-md return-product-card">

    <div class="product-card-head">

      <div>

        <span class="section-eyebrow">
          ITEM TO RETURN
        </span>

        <h2 class="text-section-title">
          Product Details
        </h2>

      </div>

      <span class="return-eligible-badge">
        Return eligible
      </span>

    </div>

    <div class="return-product">

      <div class="return-product-image">

        <img
          src="<%= item.variantId?.images?.[0]?.url || item.productImage || '/images/no-image.png' %>"
          alt="<%= item.productName %>"
        >

      </div>

      <div class="return-product-content">

        <div class="return-product-top">

          <div class="return-product-info">

            <h3>
              <%= item.productName %>
            </h3>

            <p class="product-variant">

              <span>
                <%= item.color %>
              </span>

              <span>
                •
              </span>

              <span>
                Size <%= item.size %>
              </span>

              <span>
                •
              </span>

              <span>
                Qty <%= item.quantity %>
              </span>

            </p>

          </div>

          <div class="product-paid">

            <span>
              Amount Paid
            </span>

            <strong>
              ₹<%= Number(paidAmount).toLocaleString(
                "en-IN",
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>
            </strong>

          </div>

        </div>

        <div class="product-timeline">

          <div class="product-date">

            <span>
              Delivered
            </span>

            <strong>
              <%= new Date(
                item.statusUpdatedAt
              ).toLocaleDateString(
                "en-IN",
                {
                  day: "numeric",
                  month: "long",
                  year: "numeric"
                }
              ) %>
            </strong>

          </div>

          <span class="timeline-separator"></span>

          <div class="product-date">

            <span>
              Return available until
            </span>

            <strong class="return-deadline">
              <%= returnLastDate.toLocaleDateString(
                "en-IN",
                {
                  day: "numeric",
                  month: "long",
                  year: "numeric"
                }
              ) %>
            </strong>

          </div>

        </div>

      </div>

    </div>

  </section>

  <section class="card card-md return-section">

    <div class="section-heading">

      <span class="section-eyebrow">
        RETURN REASON
      </span>

      <h2 class="text-section-title">
        Why are you returning this item?
      </h2>

      <p class="section-description">
        Choose the reason that best describes your return.
      </p>

    </div>

    <select
      id="returnReason"
      class="select-field"
    >

      <option value="">
        Select Reason
      </option>

      <option>
        Size too small
      </option>

      <option>
        Size too large
      </option>

      <option>
        Quality not as expected
      </option>

      <option>
        Received wrong item
      </option>

      <option>
        Product damaged
      </option>

      <option>
        Changed my mind
      </option>

      <option>
        Other
      </option>

    </select>

    <span
      class="error-msg"
      id="reasonError"
    ></span>

  </section>

  <section class="card card-md return-section">

    <div class="section-heading">

      <span class="section-eyebrow">
        OPTIONAL
      </span>

      <h2 class="text-section-title">
        Additional Comments
      </h2>

      <p class="section-description">
        Add any additional details that may help us review the request.
      </p>

    </div>

    <textarea
      id="returnComments"
      class="input-field return-comments"
      placeholder="Add additional details"
    ></textarea>

  </section>

  <section class="card card-md return-section pickup-card">

    <div class="pickup-section-head">

      <div class="section-heading section-heading--compact">

        <span class="section-eyebrow">
          PICKUP
        </span>

        <h2 class="text-section-title">
          Pickup Address
        </h2>

        <p class="section-description">
          The courier will collect the item from this address.
        </p>

      </div>

      <button
        type="button"
        class="pickup-change-btn"
        id="changePickupBtn"
      >
        Change Address
      </button>

    </div>

    <div
      class="checkout-address-grid collapsed"
      id="pickupSelector"
    >

      <label
        class="checkout-address active"
        id="defaultPickupCard"
      >

        <input
          type="radio"
          name="pickupAddress"
          value="delivery"
          checked
          class="hidden pickup-address-radio"
        >

        <span
          class="address-badge"
          id="pickupBadge"
        >
          Delivery Address
        </span>

        <h3
          class="address-name"
          id="pickupName"
        >
          <%= pickupAddress.fullName %>
        </h3>

        <div class="address-body">

          <p
            class="address-text"
            id="pickupLine1"
          >
            <%= pickupAddress.line1 %>
          </p>

          <% if (pickupAddress.line2) { %>

            <p
              class="address-text"
              id="pickupLine2"
            >
              <%= pickupAddress.line2 %>
            </p>

          <% } %>

          <p
            class="address-text"
            id="pickupCityState"
          >
            <%= pickupAddress.city %>,
            <%= pickupAddress.state %>
          </p>

          <p
            class="address-text"
            id="pickupPincode"
          >
            <%= pickupAddress.pincode %>
          </p>

        </div>

        <p
          class="address-phone"
          id="pickupPhone"
        >
          +91 <%= pickupAddress.phone %>
        </p>

      </label>

      <% addresses.forEach(address => { %>

        <label class="checkout-address">

          <input
            type="radio"
            name="pickupAddress"
            value="<%= address._id %>"
            class="hidden pickup-address-radio"
          >

          <% if (address.isDefault) { %>

            <span class="address-badge">
              Default
            </span>

          <% } else { %>

            <span class="address-badge address-badge--muted">
              Saved Address
            </span>

          <% } %>

          <h3 class="address-name">
            <%= address.fullName %>
          </h3>

          <div class="address-body">

            <p class="address-text">
              <%= address.line1 %>
            </p>

            <% if (address.line2) { %>

              <p class="address-text">
                <%= address.line2 %>
              </p>

            <% } %>

            <p class="address-text">
              <%= address.city %>,
              <%= address.state %>
            </p>

            <p class="address-text">
              <%= address.pincode %>
            </p>

          </div>

          <p class="address-phone">
            +91 <%= address.phone %>
          </p>

        </label>

      <% }) %>

      <button
        type="button"
        class="add-address-card"
        id="openPickupAddressModal"
      >

        <span class="add-address-icon">
          +
        </span>

        <span>
          Add New Pickup Address
        </span>

      </button>

    </div>

  </section>

  <section class="card card-md return-section">

    <div class="section-heading">

      <span class="section-eyebrow">
        REFUND
      </span>

      <h2 class="text-section-title">
        Refund Information
      </h2>

    </div>

    <div class="refund-info">

      <div class="refund-icon">
        ✓
      </div>

      <div class="refund-content">

        <div class="refund-head">

          <span>
            Refund amount
          </span>

          <strong>
            ₹<%= Number(paidAmount).toLocaleString(
              "en-IN",
              {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              }
            ) %>
          </strong>

        </div>

        <p>
          After the returned item passes quality inspection, the refund will be credited to your
          <strong>Commoncore Wallet</strong>.
        </p>

      </div>

    </div>

  </section>

  <section class="card card-md return-section">

    <div class="section-heading">

      <span class="section-eyebrow">
        RETURN POLICY
      </span>

      <h2 class="text-section-title">
        Before You Continue
      </h2>

    </div>

    <ul class="return-policy">

      <li>
        <span>✓</span>

        <p>
          Returns are accepted within 14 days of delivery.
        </p>
      </li>

      <li>
        <span>✓</span>

        <p>
          Items must be unused, unwashed and returned with original tags.
        </p>
      </li>

      <li>
        <span>✓</span>

        <p>
          Refunds are processed after the returned item passes inspection.
        </p>
      </li>

    </ul>

  </section>

  <div class="return-actions">

    <a
      href="/user/order/<%= order._id %>"
      class="secondary-btn"
    >
      Cancel
    </a>

    <button
      type="button"
      class="primary-btn"
      id="requestReturnBtn"
      data-order-id="<%= order._id %>"
      data-item-id="<%= item._id %>"
    >
      Request Return
    </button>

  </div>

</main>

<div
  class="checkout-address-modal"
  id="pickupAddressModal"
>

  <div class="checkout-address-modal-content">

    <div class="address-modal-head">

      <h3>
        Add Pickup Address
      </h3>

      <button
        type="button"
        class="modal-close"
        id="closePickupAddressModal"
      >
        ×
      </button>

    </div>

    <form id="pickupAddressForm">

      <input
        type="text"
        name="fullName"
        placeholder="Full Name"
      >

      <span
        class="error-msg"
        id="pickupFullNameError"
      ></span>

      <input
        type="text"
        name="phone"
        placeholder="Phone Number"
      >

      <span
        class="error-msg"
        id="pickupPhoneError"
      ></span>

      <input
        type="text"
        name="line1"
        placeholder="House / Street / Area"
      >

      <span
        class="error-msg"
        id="pickupLine1Error"
      ></span>

      <input
        type="text"
        name="line2"
        placeholder="Landmark (Optional)"
      >

      <input
        type="text"
        name="city"
        placeholder="City"
      >

      <span
        class="error-msg"
        id="pickupCityError"
      ></span>

      <input
        type="text"
        name="state"
        placeholder="State"
      >

      <span
        class="error-msg"
        id="pickupStateError"
      ></span>

      <input
        type="text"
        name="pincode"
        placeholder="Pincode"
      >

      <span
        class="error-msg"
        id="pickupPincodeError"
      ></span>

      <div class="checkout-address-form-actions">

        <button
          type="submit"
          class="primary-btn"
        >
          Use This Address
        </button>

        <button
          type="button"
          class="secondary-btn"
          id="closePickupAddressModalSecondary"
        >
          Cancel
        </button>

      </div>

    </form>

  </div>

</div>

<input
  type="hidden"
  id="pickupAddressType"
  value="delivery"
>

<input
  type="hidden"
  id="pickupAddressId"
>

<input
  type="hidden"
  id="pickupAddressData"
>

<div
  id="confirmReturnModal"
  class="cancel-modal hidden"
>

  <div class="cancel-modal-content">

    <div class="modal-header">

      <h2>
        Confirm Return Request
      </h2>

      <button
        type="button"
        id="closeConfirmReturnModal"
        class="modal-close"
      >
        ×
      </button>

    </div>

    <div class="cancel-product">

      <img
        src="<%= item.variantId?.images?.[0]?.url || item.productImage || '/images/default-product.jpg' %>"
        alt="<%= item.productName %>"
      >

      <div>

        <h3>
          <%= item.productName %>
        </h3>

        <p>
          <%= item.color %> /
          <%= item.size %>
          · Qty <%= item.quantity %>
        </p>

        <strong>
          ₹<%= Number(paidAmount).toLocaleString(
            "en-IN",
            {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ) %>
        </strong>

        <p
          id="retRequestReason"
          class="confirm-return-reason"
        ></p>

      </div>

    </div>

    <p class="cancel-return-note">
      Are you sure you want to submit this return request?
    </p>

    <div class="cancel-modal-actions">

      <button
        type="button"
        id="keepReturnRequestBtn"
        class="secondary-btn"
      >
        Not Now
      </button>

      <button
        type="button"
        id="confirmReturnRequestBtn"
        class="primary-btn"
      >
        Confirm Return Request
      </button>

    </div>

  </div>

</div>

<div
  id="returnSuccessModal"
  class="cancel-modal hidden"
>

  <div class="cancel-modal-content return-success-modal-content">

    <div class="return-success-icon">
      ✓
    </div>

    <div class="return-success-heading">

      <h2>
        Return Request Submitted
      </h2>

      <p
        id="cancelReturnNote"
        class="return-success-message"
      ></p>

    </div>

    <div class="cancel-modal-actions return-success-actions">

      <a
        href="#"
        id="viewReturnDetailsBtn"
        class="primary-btn"
      >
        View Return Details
      </a>

      <a
        href="/user/orders"
        class="secondary-btn"
      >
        Back to Orders
      </a>

    </div>

  </div>

</div>

<%- include("../partials/user-scripts") %>

<script src="/js/user/returnRequest.js"></script>

</body>
</html>