<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup</title>

  <link rel="stylesheet" href="/css/user/global.css">
  <link rel="stylesheet" href="/css/user/signup.css">
  <link rel="stylesheet" href="/css/user/otp-modal.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >
</head>

<body>

  <div class="page-wrapper">

    <header class="navbar">
      <a href="/" class="logo-wrap">
        <img
          src="/images/logo.png"
          alt="Common Core"
          class="logo"
        >
      </a>
    </header>

    <main class="main-content">

      <section class="signup-card">

        <div class="signup-header">
          <h1>CREATE ACCOUNT</h1>

          <p class="subtitle">
            Join our community for a simplified shopping
            experience
          </p>
        </div>

        <form
          class="signup-form"
          id="signupForm"
          novalidate
        >

          <div class="form-group">
            <label for="name">Full Name</label>

            <input
              type="text"
              placeholder="John Doe"
              name="name"
              id="name"
              value="<%= formData?.name || '' %>"
              autocomplete="name"
            >

            <span
              class="error-msg"
              id="nameError"
            ></span>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>

            <input
              type="email"
              placeholder="name@example.com"
              name="email"
              id="email"
              value="<%= formData?.email || '' %>"
              autocomplete="email"
            >

            <span
              class="error-msg"
              id="emailError"
            ></span>
          </div>

          <div class="form-group">
            <label for="password">Password</label>

            <div class="input-icon-wrap">
              <input
                type="password"
                placeholder="••••••••"
                name="password"
                id="password"
                autocomplete="new-password"
              >

              <button
                type="button"
                class="eye-icon"
                id="passwordEye"
                aria-label="Show password"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>

            <small>
              MINIMUM 8 CHARACTERS WITH AT LEAST ONE NUMBER AND SPECIAL CHARACTER
            </small>

            <span
              class="error-msg"
              id="passwordError"
            ></span>
          </div>

          <div class="form-group">
            <label for="confirmPassword">
              Confirm Password
            </label>

            <div class="input-icon-wrap">
              <input
                type="password"
                placeholder="••••••••"
                name="confirmPassword"
                id="confirmPassword"
                autocomplete="new-password"
              >

              <button
                type="button"
                class="eye-icon"
                id="confirmPassEye"
                aria-label="Show password"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>

            <span
              class="error-msg"
              id="confirmPasswordError"
            ></span>
          </div>

          <div class="form-group">
            <label for="referralCode">
              Referral Code
              <span class="optional-text">(Optional)</span>
            </label>

            <input
              type="text"
              name="referralCode"
              id="referralCode"
              placeholder="EX: CORE123"
              autocomplete="off"
              maxlength="20"
            >

            <span
              class="error-msg"
              id="referralCodeError"
            ></span>
          </div>

          <p
            class="error-msg server-error"
            id="serverError"
          ></p>

          <button
            type="submit"
            class="create-btn"
          >
            Create Account
          </button>

          <div class="divider">
            <span>OR SIGN UP WITH</span>
          </div>

          <a
            href="/user/auth/google"
            class="google-btn"
          >
            <img
              src="https://www.svgrepo.com/show/475656/google-color.svg"
              alt="Google"
            >
            <span>Google</span>
          </a>

          <p class="signin-text">
            Already have an account?
            <a href="/user/login">Sign In</a>
          </p>

        </form>

      </section>

    </main>

    <footer class="footer">

      <div class="footer-links">
        <a href="#">ABOUT</a>
        <a href="#">PRIVACY POLICY</a>
        <a href="#">CONTACT</a>
      </div>

      <p class="footer-copy">
        © 2024 COMMON CORE. ALL RIGHTS RESERVED.
      </p>

    </footer>

  </div>

  <%- include("../partials/otp-modal") %>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/user/otpModal.js"></script>
  <script src="/js/user/signup.js"></script>

</body>
</html>