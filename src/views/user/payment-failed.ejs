<!DOCTYPE html>
<html lang="en">

<head>
  <title>Payment Failed — Commoncore</title>

  <%- include("../partials/user-head") %>

  <link
    rel="stylesheet"
    href="/css/user/payment-failed.css"
  >
</head>

<body>

<%- include("../partials/user-header") %>

<main class="success-page">

  <section class="success-hero card card-lg">

    <div class="failed-icon">
      ✕
    </div>

    <h1 class="success-title">
      Payment Unsuccessful
    </h1>

    <p class="success-text">
      We couldn't complete your payment. Your order has been saved,
      but it will only be confirmed after successful payment.
    </p>

    <div class="success-meta">

      <div class="success-meta-item">
        <span>Order Number</span>

        <strong>
          <%= order.orderNumber %>
        </strong>
      </div>

      <div class="success-meta-item">
        <span>Payment Status</span>

        <strong>
          <%= order.paymentStatus %>
        </strong>
      </div>

      <div class="success-meta-item">
        <span>Order Status</span>

        <strong>
          <%= order.orderStatus %>
        </strong>
      </div>

      <div class="success-meta-item">
        <span>Date</span>

        <strong>
          <%= new Date(order.createdAt).toLocaleDateString(
            "en-IN",
            {
              day: "numeric",
              month: "long",
              year: "numeric",
            },
          ) %>
        </strong>
      </div>

    </div>

  </section>

  <div class="success-top-grid">

    <section class="success-card card card-md">

      <div class="success-card-head">
        <h3 class="text-card-title">
          What happened?
        </h3>
      </div>

      <div class="success-address">

        <p>
          • The payment was cancelled or unsuccessful.
        </p>

        <p>
          • Your order is saved as Payment Pending.
        </p>

        <p>
          • Stock has not been reduced and the order is not confirmed yet.
        </p>

        <% if (order.paymentFailure?.description) { %>

          <p class="payment-failure-reason">
            <strong>Reason:</strong>
            <%= order.paymentFailure.description %>
          </p>

        <% } %>

      </div>

    </section>

    <section class="success-card card card-md">

      <div class="success-card-head">
        <h3 class="text-card-title">
          Next Steps
        </h3>
      </div>

      <div class="delivery-info">

        <div class="delivery-row">
          <span>Retry Payment</span>

          <strong>
            <%= canRetryPayment
              ? "Available"
              : "Unavailable" %>
          </strong>
        </div>

        <div class="delivery-row">
          <span>Order Details</span>

          <strong>
            Available
          </strong>
        </div>

        <div class="delivery-row">
          <span>Payment Session</span>

          <strong>
            <%= paymentExpired
              ? "Expired"
              : "Active" %>
          </strong>
        </div>

      </div>

    </section>

  </div>

  <div class="success-actions">

    <% if (canRetryPayment) { %>

      <button
        type="button"
        class="primary-btn"
        id="retryPaymentBtn"
        data-order-id="<%= order._id %>"
      >
        Retry Payment
      </button>

    <% } %>

    <a
      href="/user/order/<%= order._id %>"
      class="<%= canRetryPayment
        ? 'secondary-btn'
        : 'primary-btn' %>"
    >
      View Order Details
    </a>

    <a
      href="/user/orders"
      class="secondary-btn"
    >
      My Orders
    </a>

  </div>

</main>

<%- include("../partials/user-scripts") %>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/user/paymentFailed.js"></script>

</body>

</html>