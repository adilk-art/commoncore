<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    <%= paymentExpired ? "Payment Expired" : "Payment Failed" %>
    — Commoncore
  </title>

  <%- include("../partials/user-head") %>

  <link
    rel="stylesheet"
    href="/css/user/payment-failed.css"
  >

</head>

<body>

<%- include("../partials/user-header") %>


<main class="success-page">


  <section
    class="
      success-hero
      card
      card-lg
      <%= paymentExpired
        ? 'success-hero--expired'
        : '' %>
    "
  >

    <div
      class="
        failed-icon
        <%= paymentExpired
          ? 'failed-icon--expired'
          : '' %>
      "
    >

      <%= paymentExpired
        ? "⌛"
        : "✕" %>

    </div>


    <h1 class="success-title">

      <%= paymentExpired
        ? "Payment Window Expired"
        : "Payment Unsuccessful" %>

    </h1>


    <p class="success-text">

      <% if (paymentExpired) { %>

        The payment window for this payment attempt has expired.
        You can return to checkout and place a fresh order using
        any available payment method.

      <% } else { %>

        We couldn't complete your payment.
        You can retry Razorpay before the payment window expires,
        or return to checkout and choose another payment method.

      <% } %>

    </p>


    <div class="success-meta">


      <div class="success-meta-item">

        <span>
          Order Number
        </span>

        <strong>
          <%= order.orderNumber %>
        </strong>

      </div>


      <div class="success-meta-item">

        <span>
          Payment Status
        </span>

        <strong
          class="
            meta-status
            <%= paymentExpired
              ? 'meta-status--expired'
              : 'meta-status--pending' %>
          "
        >

          <%= paymentExpired
            ? "Failed"
            : order.paymentStatus %>

        </strong>

      </div>


      <div class="success-meta-item">

        <span>
          Order Status
        </span>

        <strong
          class="
            meta-status
            <%= paymentExpired
              ? 'meta-status--expired'
              : 'meta-status--pending' %>
          "
        >

          <%= order.orderStatus %>

        </strong>

      </div>


      <div class="success-meta-item">

        <span>
          Date
        </span>

        <strong>

          <%= new Date(
            order.createdAt
          ).toLocaleDateString(
            "en-IN",
            {
              day: "numeric",
              month: "long",
              year: "numeric",
            }
          ) %>

        </strong>

      </div>


    </div>

  </section>


  <div class="success-top-grid">


    <section class="success-card card card-md">


      <div class="success-card-head">

        <h3 class="text-card-title">

          <%= paymentExpired
            ? "What happened?"
            : "Payment Information" %>

        </h3>

      </div>


      <div class="success-address">


        <% if (paymentExpired) { %>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              The payment window for this Razorpay attempt has ended.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              This payment attempt was not converted into a confirmed order.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              Stock was not deducted because the payment was not completed.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              Your cart can be reviewed again through checkout with fresh validation.
            </p>

          </div>


        <% } else { %>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              !
            </span>

            <p>
              Your previous Razorpay payment attempt was unsuccessful.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              You can retry Razorpay while the current payment window is active.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              You can also return to checkout and choose another payment method.
            </p>

          </div>


          <div class="payment-info-row">

            <span class="payment-info-icon">
              ✓
            </span>

            <p>
              Stock has not been deducted because the payment is not confirmed.
            </p>

          </div>

        <% } %>


      </div>

    </section>


    <section class="success-card card card-md">


      <div class="success-card-head">

        <h3 class="text-card-title">
          Next Steps
        </h3>

      </div>


      <div class="delivery-info">


        <div class="delivery-row">

          <span>
            Retry Razorpay
          </span>

          <strong
            class="<%= canRetryPayment
              ? 'delivery-value--active'
              : 'delivery-value--expired' %>"
          >

            <%= canRetryPayment
              ? "Available"
              : "Expired" %>

          </strong>

        </div>


        <div class="delivery-row">

          <span>
            Checkout Again
          </span>

          <strong class="delivery-value--active">
            Available
          </strong>

        </div>


        <div class="delivery-row">

          <span>
            Payment Session
          </span>

          <strong
            class="<%= paymentExpired
              ? 'delivery-value--expired'
              : 'delivery-value--active' %>"
          >

            <%= paymentExpired
              ? "Expired"
              : "Active" %>

          </strong>

        </div>


        <div class="delivery-row">

          <span>
            Order Confirmation
          </span>

          <strong class="delivery-value--failed">
            Not Confirmed
          </strong>

        </div>


      </div>

    </section>


  </div>


  <div class="success-actions">


    <% if (canRetryPayment) { %>

      <button
        type="button"
        class="primary-btn"
        id="retryPaymentBtn"
        data-order-id="<%= order._id %>"
      >
        Retry Payment
      </button>

    <% } %>


    <a
      href="/user/checkout"
      class="<%= canRetryPayment
        ? 'secondary-btn'
        : 'primary-btn' %>"
    >
      Back to Checkout
    </a>


    <a
      href="/user/order/<%= order._id %>"
      class="secondary-btn"
    >
      View Order Details
    </a>


    <a
      href="/user/orders"
      class="secondary-btn"
    >
      My Orders
    </a>


  </div>


</main>


<%- include("../partials/user-scripts") %>


<% if (canRetryPayment) { %>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script src="/js/user/paymentFailed.js"></script>

<% } %>


</body>

</html>