<!DOCTYPE html>
<html lang="en">

<head>

  <title>
    Checkout — Commoncore
  </title>

  <%- include('../partials/user-head') %>

  <link
    rel="stylesheet"
    href="/css/user/checkout.css"
  >

</head>

<body>

<%- include('../partials/user-header') %>

<main class="checkout-page">

  <% if (invalidCart) { %>

    <div class="checkout-warning card card-md">

      <div>

        <h2 class="text-section-title">
          Some items in your cart are unavailable
        </h2>

        <p class="text-body">
          <%= message %>
        </p>

      </div>

      <a
        href="/user/cart"
        class="primary-btn"
      >
        Review Cart
      </a>

    </div>

  <% } %>

  <div class="checkout-layout <%= invalidCart ? 'checkout-disabled' : '' %>">

    <!-- LEFT -->

    <section class="checkout-main">

      <!-- ADDRESS -->

      <section class="checkout-section">

        <div class="checkout-section-head">

          <div class="checkout-step">
            1
          </div>

          <h2 class="text-section-title">
            Shipping Address
          </h2>

        </div>

        <div class="checkout-address-grid">

  <% addresses.forEach(address => { %>

    <label
      class="checkout-address <%= address.isDefault ? 'active' : '' %>"
    >

      <input
        type="radio"
        name="address"
        value="<%= address._id %>"
        class="hidden address-radio"
        <%= address.isDefault ? 'checked' : '' %>
      >

      <div class="checkout-address-top">

        <% if(address.isDefault){ %>

          <span class="address-badge">
            Default
          </span>

        <% } %>

        <button
          type="button"
          class="checkout-edit-address-btn"
          data-id="<%= address._id %>"
          data-fullname="<%= address.fullName %>"
          data-phone="<%= address.phone %>"
          data-line1="<%= address.line1 %>"
          data-line2="<%= address.line2 || '' %>"
          data-city="<%= address.city %>"
          data-state="<%= address.state %>"
          data-pincode="<%= address.pincode %>"
          data-default="<%= address.isDefault %>"
        >
          Edit
        </button>

      </div>

      <h3 class="address-name">
        <%= address.fullName %>
      </h3>

      <p class="address-text">
        <%= address.line1 %>
      </p>

      <% if(address.line2){ %>

        <p class="address-text">
          <%= address.line2 %>
        </p>

      <% } %>

      <p class="address-text">
        <%= address.city %>,
        <%= address.state %>
      </p>

      <p class="address-text">
        <%= address.pincode %>
      </p>

      <p class="address-phone">
        +91 <%= address.phone %>
      </p>

    </label>

  <% }) %>

  <button
    type="button"
    class="add-address-card"
    id="openAddAddressModal"
  >
    <span>
      + Add Address
    </span>
  </button>

</div>

      </section>

      <!-- PAYMENT -->

      <section class="checkout-section">

        <div class="checkout-section-head">

      <div class="checkout-step">
        2
      </div>

      <h2 class="text-section-title">
        Payment Method
      </h2>

      

    </div>

        <div class="payment-options">

        <label class="payment-option active">

          <input
            type="radio"
            name="payment"
            value="Razorpay"
            checked
            class="hidden payment-radio"
          >

          <div>
            <h3 class="payment-title">Pay Now (Razorpay)</h3>
            <p class="text-muted">UPI, Cards</p>
          </div>

        </label>

<label class="payment-option <%= !canUseWallet ? 'disabled' : '' %>">

  <input
    type="radio"
    name="payment"
    value="Wallet"
    class="hidden payment-radio"
    <%= !canUseWallet ? "disabled" : "" %>
  >

  <div class="payment-info">

    <h3 class="payment-title">
      Wallet
    </h3>

    <p class="text-muted">
      Balance:
      <strong>₹<%= wallet.balance.toFixed(2) %></strong>
    </p>

    <% if (!canUseWallet) { %>

      <p class="wallet-warning">
        Insufficient wallet balance
      </p>

    <% } %>

  </div>

</label>

          <label class="payment-option">

          <input
            type="radio"
            name="payment"
            value="CashOnDelivery"
            class="hidden payment-radio"
          >

          <div>
            <h3 class="payment-title">Cash on Delivery</h3>
            <p class="text-muted">Pay after delivery</p>
          </div>

        </label>

        </div>

      </section>

    </section>

    <!-- RIGHT -->

    <aside class="checkout-summary card card-md">

      <h2 class="text-section-title">
        Order Summary
      </h2>

      <div class="summary-products">

        <% cart.items.forEach(item => { %>

<div class="summary-product">

  <img
    src="<%= item.variant.images?.[0]?.url || '/images/no-image.png' %>"
    alt="<%= item.product.name %>"
  >

  <div class="summary-product-info">

    <h4>
      <%= item.product.name %>
    </h4>

    <p>
      Qty: <%= item.quantity %>
    </p>

    <% if (item.hasOffer) { %>
      <span class="checkout-offer-badge">

        <% if (item.discountType === "PERCENTAGE") { %>
          <%= Number(item.discountValue) %>% OFF
        <% } else { %>
          ₹<%= Number(item.discountValue).toLocaleString("en-IN") %> OFF
        <% } %>

      </span>
    <% } %>

  </div>

  <div class="summary-product-price">

    <span class="summary-product-current">
      ₹<%= Number(item.lineTotal).toLocaleString("en-IN") %>
    </span>

    <% if (item.hasOffer) { %>
      <span class="summary-product-old">
        ₹<%= Number(item.lineOriginalTotal).toLocaleString("en-IN") %>
      </span>
    <% } %>

  </div>

</div>

        <% }) %>

      </div>

      <div class="summary-divider"></div>

<div class="summary-row">
  <span>Original subtotal</span>

  <span id="checkoutOriginalSubtotal">
    ₹<%= Number(cart.originalSubtotal).toLocaleString("en-IN") %>
  </span>
</div>

<div
  class="summary-row summary-row--discount"
  <%= cart.totalDiscount <= 0 ? "hidden" : "" %>
>
  <span>Offer discount</span>

  <span id="checkoutDiscount">
    −₹<%= Number(cart.totalDiscount).toLocaleString("en-IN") %>
  </span>
</div>

<div class="summary-row">
  <span>Subtotal</span>

  <span id="checkoutSubtotal">
    ₹<%= Number(cart.subtotal).toLocaleString("en-IN") %>
  </span>
</div>

<div class="summary-row">
  <span>GST Included</span>

  <span>
    ₹<%= Number(gstAmount).toFixed(2) %>
  </span>
</div>

<div class="summary-row">
  <span>Shipping</span>

  <span>
    <%= shipping === 0
      ? "Free"
      : `₹${Number(shipping).toLocaleString("en-IN")}` %>
  </span>
</div>

<div class="summary-divider"></div>

<div class="summary-row summary-total">

  <span>
    Total

    <span class="text-muted gst-note">
      Inclusive of GST
    </span>
  </span>

  <span>
    ₹<%= Number(total).toLocaleString("en-IN") %>
  </span>

</div>

      <!-- <div class="summary-row">
        <span>GST Included</span>
        <span>
          ₹<%= gstAmount.toFixed(2) %>
        </span>
      </div>

      <div class="summary-row">
        <span>Shipping</span>
        <span>
          <%= shipping === 0 ? 'Free' : `₹${shipping}` %>
        </span>
      </div>

      <div class="summary-divider"></div>

      <div class="summary-row summary-total">

        <span>
          Total      
          <span class="text-muted gst-note">
          (Inclusive of GST.)
          </span>
        </span>
        
        <span>
          ₹<%= total.toLocaleString('en-IN') %>
        </span>
        
      </div> -->


      <button
        class="primary-btn place-order-btn"
        id="placeOrderBtn"
        <%= invalidCart ? 'disabled' : '' %>
      >
        Place Order
      </button>

    </aside>
    <input type="hidden" id="isBuyNow" value="<%= isBuyNow ? 'true' : 'false' %>">
    <% if (isBuyNow) { %>
      <input type="hidden" id="buyNowVariantId" value="<%= buyNow.variantId %>">
      <input type="hidden" id="buyNowQuantity" value="<%= buyNow.quantity %>">
    <% } %>
  </div>

</main>
<div
  class="checkout-address-modal"
  id="addressModal"
>

  <div class="checkout-address-modal-content">

    <h3 id="addressFormTitle">
      Add New Address
    </h3>

    <form id="addressForm">

      <input
        type="hidden"
        name="addressId"
        id="addressId"
      >

      <input
        type="text"
        name="fullName"
        placeholder="Full Name"
      >

      <span
        class="error-msg"
        id="fullNameError"
      ></span>

      <input
        type="text"
        name="phone"
        placeholder="Phone Number"
      >

      <span
        class="error-msg"
        id="phoneError"
      ></span>

      <input
        type="text"
        name="line1"
        placeholder="House / Street / Area"
      >

      <span
        class="error-msg"
        id="line1Error"
      ></span>

      <input
        type="text"
        name="line2"
        placeholder="Landmark (Optional)"
      >

      <input
        type="text"
        name="city"
        placeholder="City"
      >

      <span
        class="error-msg"
        id="cityError"
      ></span>

      <input
        type="text"
        name="state"
        placeholder="State"
      >

      <span
        class="error-msg"
        id="stateError"
      ></span>

      <input
        type="text"
        name="pincode"
        placeholder="Pincode"
      >

      <span
        class="error-msg"
        id="pincodeError"
      ></span>

      <label class="checkout-default-checkbox">

        <input
          type="checkbox"
          name="isDefault"
        >

        Set as Default Address

      </label>

      <div class="checkout-address-form-actions">

        <button
          type="submit"
          class="primary-btn"
        >
          Save Address
        </button>

        <button
          type="button"
          class="secondary-btn"
          id="closeAddressModal"
        >
          Cancel
        </button>

      </div>

    </form>

  </div>

</div>

<%- include('../partials/user-scripts') %>

<script src="/js/user/checkout.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

</body>
</html>