<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>My Orders</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >

  <link rel="stylesheet" href="/css/user/standard.css">
  <link rel="stylesheet" href="/css/user/style.css">
  <link rel="stylesheet" href="/css/user/profile.css">
  <link rel="stylesheet" href="/css/user/orders.css">
  <link rel="stylesheet" href="/css/user/global.css">
  <link rel="stylesheet" href="/css/user/toast.css">
  <link rel="stylesheet" href="/css/user/user-header.css">
</head>

<body>

  <%- include("../partials/user-header") %>
  <%- include("../partials/user-logout-modal") %>

  <div class="account-container">

    <%- include("../partials/sidebar", {
      active: "orders"
    }) %>

    <div class="main-content">

      <div class="page-header">

        <h2 class="page-title">MY ORDERS</h2>

        <p class="page-subtitle">
          Track and manage your orders
        </p>

      </div>

      <form
        class="search-bar"
        method="GET"
        action="/user/orders"
      >

        <i class="fa-solid fa-magnifying-glass"></i>

        <input
          type="text"
          name="search"
          placeholder="Search Order ID..."
          value="<%= search || '' %>"
        >

        <button
          type="button"
          class="clear-search <%= !search ? 'hidden' : '' %>"
          onclick="window.location.href='/user/orders'"
          aria-label="Clear search"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>

      </form>

      <% if (!orders || orders.length === 0) { %>

        <div class="empty-orders">

          <div class="empty-box">

            <div class="icon">
              📦
            </div>

            <% if (search) { %>

              <h3>
                No matching orders found
              </h3>

              <p>
                Try searching with another order number.
              </p>

            <% } else { %>

              <h3>
                No Orders Yet
              </h3>

              <p>
                Start shopping to see your orders here.
              </p>

            <% } %>

          </div>

        </div>

      <% } else { %>

        <div class="orders-list">

          <% orders.forEach((order) => { %>

            <%
              const firstItem =
                order.items && order.items.length > 0
                  ? order.items[0]
                  : null;

              const totalItems = Array.isArray(order.items)
                ? order.items.reduce((sum, item) => {
                    return sum + (Number(item.quantity) || 0);
                  }, 0)
                : 0;

              const isPaymentPending =
                order.orderStatus === "Payment Pending";

              const isPaymentExpired =
                order.orderStatus === "Payment Expired";

              const statusValue =
                isPaymentPending || isPaymentExpired
                  ? order.orderStatus
                  : order.itemsSingleStatus ||
                    order.orderStatus ||
                    "Placed";

              const statusClass = String(statusValue)
                .toLowerCase()
                .trim()
                .replace(/\s+/g, "-");
            %>

            <div class="order-row">

              <div class="product-image">

                <img
                  src="<%= firstItem?.productImage || '/images/default-product.jpg' %>"
                  alt="<%= firstItem?.productName || 'Product image' %>"
                >

              </div>

              <div>

                <span class="column-title">
                  ORDER ID
                </span>

                <h4>
                  <%= order.orderNumber %>
                </h4>

              </div>

              <div>

                <span class="column-title">
                  PRODUCT DETAILS
                </span>

                <p class="product-name">

                  <%= firstItem?.productName || "Product unavailable" %>

                  <% if (order.items && order.items.length > 1) { %>

                    <br>

                    + <%= order.items.length - 1 %> more

                  <% } %>

                </p>

              </div>

              <div>

                <span class="column-title">
                  TOTAL ITEMS
                </span>

                <h4>
                  <%= totalItems %>
                  Item<%= totalItems !== 1 ? "s" : "" %>
                </h4>

              </div>

              <div>

                <span class="column-title">
                  AMOUNT
                </span>

                <h4>
                  ₹<%= Number(order.total || 0).toFixed(2) %>
                </h4>

              </div>

              <div>

                <span class="column-title">
                  ORDER DATE
                </span>

                <p>
                  <%= new Date(
                    order.createdAt
                  ).toLocaleDateString("en-IN") %>
                </p>

              </div>

              <div class="order-status-cell">

                <span class="column-title">
                  STATUS
                </span>

                <% if (isPaymentPending || isPaymentExpired) { %>

                  <div class="status-text status-<%= statusClass %>">

                    <span class="status-dot"></span>

                    <span>
                      <%= statusValue %>
                    </span>

                  </div>

                <% } else if (!order.itemsStatusMixed) { %>

                  <div class="status-text status-<%= statusClass %>">

                    <span class="status-dot"></span>

                    <span>
                      <%= statusValue %>
                    </span>

                  </div>

                <% } else { %>

                  <div class="status-summary-list">

                    <% order.itemsStatusSummaryLines.forEach((line) => { %>

                      <%
                        const lineStatus = String(line)
                          .replace(/^\d+\s*/, "")
                          .trim();

                        const lineStatusClass = lineStatus
                          .toLowerCase()
                          .replace(/\s+/g, "-");
                      %>

                      <div class="status-summary-line status-<%= lineStatusClass %>">

                        <span class="status-dot"></span>

                        <span>
                          <%= line %>
                        </span>

                      </div>

                    <% }) %>

                  </div>

                <% } %>

              </div>

              <div>

                <a
                  href="/user/order/<%= order._id %>"
                  class="
                    view-btn
                    <%= isPaymentPending || isPaymentExpired
                      ? 'view-btn--payment'
                      : '' %>
                  "
                >
                  <%= isPaymentPending || isPaymentExpired
                    ? "Checkout Again"
                    : "View Details" %>
                </a>

              </div>

            </div>

          <% }) %>

        </div>

      <% } %>

      <% if (totalPages > 1) { %>

        <div class="pagination">

          <% for (let i = 1; i <= totalPages; i++) { %>

            <a
              href="/user/orders?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>"
              class="<%= Number(currentPage) === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>

          <% } %>

        </div>

      <% } %>

    </div>

  </div>

  <script src="/js/user/logout.js"></script>
  <script src="/js/utils/toast.js"></script>

</body>

</html>