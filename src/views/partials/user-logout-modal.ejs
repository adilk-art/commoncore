<div
  id="userLogoutModal"
  class="user-logout-modal"
>

  <div class="user-logout-modal-box">

    <h3 class="user-logout-title">
      Logout
    </h3>

    <p class="user-logout-text">
      Are you sure you want to logout?
    </p>

    <div class="user-logout-actions">

      <button
        type="button"
        class="user-logout-cancel"
        onclick="closeUserLogoutModal()"
      >
        Cancel
      </button>

      <a
        href="/user/logout"
        class="user-logout-confirm"
      >
        Logout
      </a>

    </div>

  </div>

</div>