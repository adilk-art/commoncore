<!DOCTYPE html>
<html lang="en">

<head>

  <%- include("./partials/head", {
    title: "Offers"
  }) %>

  <link
    rel="stylesheet"
    href="/css/admin/offers.css"
  >

</head>

<body>

  <%- include("./partials/header", {
    title: "Offers"
  }) %>

  <div class="layout">

    <%- include("./partials/sidebar", {
      active: "offers"
    }) %>

    <%- include("./partials/logout-modal") %>
    <%- include("../partials/confirm-modal") %>

    <div class="main">

      <div class="content">

        <div class="page-top">

          <div>

            <p class="breadcrumb">
              Admin Dashboard &gt; Offers
            </p>

            <h2 class="page-title">
              Offer Management
            </h2>

          </div>

          <a
            href="/admin/offers/add"
            class="add-offer-btn"
          >
            <i class="fa-solid fa-plus"></i>
            Create Offer
          </a>

        </div>

        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-top">
              <p>Total Offers</p>
              <i class="fa-solid fa-tags"></i>
            </div>

            <h3>
              <%= totalOffers %>
            </h3>

          </div>

          <div class="stat-card">

            <div class="stat-top">
              <p>Active Offers</p>
              <i class="fa-solid fa-circle-check"></i>
            </div>

            <h3>
              <%= activeOffers %>
            </h3>

          </div>

          <div class="stat-card">

            <div class="stat-top">
              <p>Upcoming</p>
              <i class="fa-solid fa-clock"></i>
            </div>

            <h3>
              <%= upcomingOffers %>
            </h3>

          </div>

          <div class="stat-card">

            <div class="stat-top">
              <p>Expired</p>
              <i class="fa-solid fa-hourglass-end"></i>
            </div>

            <h3>
              <%= expiredOffers %>
            </h3>

          </div>

        </div>

        <div class="table-container">

          <div class="table-header">

            <h3>Offers</h3>

            <%
              const hasFilters =
                Boolean(search) ||
                status !== "all" ||
                targetScope !== "all" ||
                discount !== "all" ||
                sort !== "latest";
            %>

            <div class="toolbar">

              <form
                action="/admin/offers"
                method="GET"
                class="filter-form"
              >

                <input
                  type="hidden"
                  name="search"
                  value="<%= search || '' %>"
                >

                <input
                  type="hidden"
                  name="page"
                  value="1"
                >

                <select
                  name="status"
                  onchange="this.form.submit()"
                >

                  <option
                    value="all"
                    <%= status === "all" ? "selected" : "" %>
                  >
                    All Status
                  </option>

                  <option
                    value="active"
                    <%= status === "active" ? "selected" : "" %>
                  >
                    Active
                  </option>

                  <option
                    value="upcoming"
                    <%= status === "upcoming" ? "selected" : "" %>
                  >
                    Upcoming
                  </option>

                  <option
                    value="expired"
                    <%= status === "expired" ? "selected" : "" %>
                  >
                    Expired
                  </option>

                  <option
                    value="disabled"
                    <%= status === "disabled" ? "selected" : "" %>
                  >
                    Disabled
                  </option>

                </select>

                <select
                  name="targetScope"
                  onchange="this.form.submit()"
                >

                  <option
                    value="all"
                    <%= targetScope === "all" ? "selected" : "" %>
                  >
                    All Scope
                  </option>

                  <option
                    value="product"
                    <%= targetScope === "product" ? "selected" : "" %>
                  >
                    Product
                  </option>

                  <option
                    value="category"
                    <%= targetScope === "category" ? "selected" : "" %>
                  >
                    Category
                  </option>

                </select>

                <select
                  name="discount"
                  onchange="this.form.submit()"
                >

                  <option
                    value="all"
                    <%= discount === "all" ? "selected" : "" %>
                  >
                    All Discounts
                  </option>

                  <option
                    value="percentage"
                    <%= discount === "percentage" ? "selected" : "" %>
                  >
                    Percentage
                  </option>

                  <option
                    value="flat"
                    <%= discount === "flat" ? "selected" : "" %>
                  >
                    Flat
                  </option>

                </select>

                <select
                  name="sort"
                  onchange="this.form.submit()"
                >

                  <option
                    value="latest"
                    <%= sort === "latest" ? "selected" : "" %>
                  >
                    Latest
                  </option>

                  <option
                    value="oldest"
                    <%= sort === "oldest" ? "selected" : "" %>
                  >
                    Oldest
                  </option>

                  <option
                    value="endingSoon"
                    <%= sort === "endingSoon" ? "selected" : "" %>
                  >
                    Ending Soon
                  </option>

                </select>

              </form>

              <form
                action="/admin/offers"
                method="GET"
                class="search-box"
              >

                <input
                  type="hidden"
                  name="status"
                  value="<%= status || 'all' %>"
                >

                <input
                  type="hidden"
                  name="targetScope"
                  value="<%= targetScope || 'all' %>"
                >

                <input
                  type="hidden"
                  name="discount"
                  value="<%= discount || 'all' %>"
                >

                <input
                  type="hidden"
                  name="sort"
                  value="<%= sort || 'latest' %>"
                >

                <input
                  type="hidden"
                  name="page"
                  value="1"
                >

                <input
                  type="text"
                  name="search"
                  value="<%= search || '' %>"
                  placeholder="Search offers..."
                >

                <button
                  type="submit"
                  aria-label="Search offers"
                >
                  <i class="fa-solid fa-search"></i>
                </button>

                <% if (hasFilters) { %>

                  <a
                    href="/admin/offers"
                    class="clear-btn"
                  >
                    <i class="fa-solid fa-xmark"></i>
                    Clear
                  </a>

                <% } %>

              </form>

            </div>

          </div>

          <table>

            <thead>

              <tr>
                <th>Offer</th>
                <th>Scope</th>
                <th>Target</th>
                <th>Discount</th>
                <th>Validity</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>

            </thead>

            <tbody>

              <% if (offers.length) { %>

                <% offers.forEach((offer) => { %>

                  <tr>

                    <td>

                      <div class="offer-title">
                        <h4>
                          <%= offer.title %>
                        </h4>
                      </div>

                    </td>

                    <td>

                      <span
                        class="scope-badge <%= offer.offerScope.toLowerCase() %>"
                      >
                        <%= offer.offerScope %>
                      </span>

                    </td>

                    <td>
                      <%= offer.appliesTo?.name || "Unavailable" %>
                    </td>

                    <td>

                      <% if (offer.discountType === "PERCENTAGE") { %>

                        <strong>
                          <%= Number(offer.discountValue) %>% OFF
                        </strong>

                        <% if (offer.maxDiscountAmount != null) { %>

                          <small class="discount-limit">
                            Max ₹<%= Number(
                              offer.maxDiscountAmount
                            ).toLocaleString("en-IN") %>
                          </small>

                        <% } %>

                      <% } else { %>

                        <strong>
                          ₹<%= Number(
                            offer.discountValue
                          ).toLocaleString("en-IN") %> OFF
                        </strong>

                      <% } %>

                    </td>

                    <td>

                      <div class="date-block">

                        <span>
                          <%= offer.startDate %>
                        </span>

                        <small>to</small>

                        <span>
                          <%= offer.endDate %>
                        </span>

                      </div>

                    </td>

                    <td>

                      <span
                        class="status <%= offer.status
                          .toLowerCase()
                          .replaceAll(' ', '-') %>"
                      >
                        <%= offer.status %>
                      </span>

                    </td>

                    <td>

                      <div class="actions">

                        <a
                          href="/admin/offers/<%= offer._id %>/edit"
                          class="icon-action"
                          title="Edit Offer"
                          data-tooltip="Edit Offer"
                        >
                          <i class="fa-solid fa-pen"></i>
                        </a>

                        <button
                          type="button"
                          class="icon-action toggle-status-btn"
                          data-id="<%= offer._id %>"
                          data-active="<%= offer.isActive %>"
                          data-tooltip="<%= offer.isActive
                            ? 'Deactivate Offer'
                            : 'Activate Offer' %>"
                        >
                          <i
                            class="fa-solid <%= offer.isActive
                              ? 'fa-eye-slash'
                              : 'fa-eye' %>"
                          ></i>
                        </button>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              <% } else { %>

                <tr>

                  <td
                    colspan="7"
                    class="empty-row"
                  >

                    <div class="empty-state">

                      <i class="fa-solid fa-tags"></i>

                      <h3>No Offers Found</h3>

                      <p>
                        Promotional offers you create will appear here.
                      </p>

                    </div>

                  </td>

                </tr>

              <% } %>

            </tbody>

          </table>

<% if (totalPages > 1) { %>

  <div class="pagination">

    <p class="results-text">
      Showing
      <%= offerCount > 0 ? skip + 1 : 0 %>
      to
      <%= Math.min(Number(currentPage) * limit, offerCount) %>
      of
      <%= offerCount %>
      results
    </p>

    <%
      const page = Number(currentPage);

      const queryString = [
        `search=${encodeURIComponent(search || "")}`,
        `status=${encodeURIComponent(status || "all")}`,
        `targetScope=${encodeURIComponent(targetScope || "all")}`,
        `discount=${encodeURIComponent(discount || "all")}`,
        `sort=${encodeURIComponent(sort || "latest")}`
      ].join("&");
    %>

    <% if (page > 1) { %>

      <a
        class="nav-btn"
        href="/admin/offers?page=<%= page - 1 %>&<%= queryString %>"
      >
        Prev
      </a>

    <% } else { %>

      <span class="nav-btn disabled">
        Prev
      </span>

    <% } %>


    <% if (totalPages <= 7) { %>

      <% for (let i = 1; i <= totalPages; i++) { %>

        <a
          class="page-btn <%= page === i ? 'active' : '' %>"
          href="/admin/offers?page=<%= i %>&<%= queryString %>"
        >
          <%= i %>
        </a>

      <% } %>

    <% } else { %>

      <a
        class="page-btn <%= page === 1 ? 'active' : '' %>"
        href="/admin/offers?page=1&<%= queryString %>"
      >
        1
      </a>

      <%
        let startPage;
        let endPage;

        if (page <= 4) {
          startPage = 2;
          endPage = 5;
        } else if (page >= totalPages - 3) {
          startPage = totalPages - 4;
          endPage = totalPages - 1;
        } else {
          startPage = page - 1;
          endPage = page + 1;
        }
      %>

      <% if (startPage > 2) { %>

        <span class="pagination-dots">
          ...
        </span>

      <% } %>


      <% for (let i = startPage; i <= endPage; i++) { %>

        <a
          class="page-btn <%= page === i ? 'active' : '' %>"
          href="/admin/offers?page=<%= i %>&<%= queryString %>"
        >
          <%= i %>
        </a>

      <% } %>


      <% if (endPage < totalPages - 1) { %>

        <span class="pagination-dots">
          ...
        </span>

      <% } %>


      <a
        class="page-btn <%= page === totalPages ? 'active' : '' %>"
        href="/admin/offers?page=<%= totalPages %>&<%= queryString %>"
      >
        <%= totalPages %>
      </a>

    <% } %>


    <% if (page < totalPages) { %>

      <a
        class="nav-btn"
        href="/admin/offers?page=<%= page + 1 %>&<%= queryString %>"
      >
        Next
      </a>

    <% } else { %>

      <span class="nav-btn disabled">
        Next
      </span>

    <% } %>

  </div>

<% } %>

        </div>

      </div>

    </div>

  </div>

  <%- include("./partials/scripts") %>

  <script src="/js/admin/offers.js"></script>

</body>

</html>