<!DOCTYPE html>
<html lang="en">
<head>

  <%- include("./partials/head", {
    title: "Order Details"
  }) %>

  <link rel="stylesheet" href="/css/admin/order-details.css">

</head>

<body>

<%- include("./partials/header", { title: "Order Details" }) %>
<%- include("./partials/logout-modal") %>

<div class="layout">

  <%- include("./partials/sidebar", { active: "orders" }) %>

  <div class="main">

    <div class="content">

      <div class="page-top">

        <div>

          <p class="breadcrumb">
            Admin Dashboard > Orders > <%= order.orderNumber %>
          </p>

          <h2 class="page-title">
            Order Details
          </h2>

        </div>

      </div>

      <div class="overview-card">

        <div class="overview-left">

          <div class="overview-title-row">

            <h3>
              #<%= order.orderNumber %>
            </h3>

            

          </div>

          <p class="order-date">
            Placed on <%= new Date(order.createdAt).toLocaleString("en-IN") %>
          </p>

        </div>

        <!-- <div class="overview-right">
            <span class="status <%= order.orderStatus.toLowerCase().replaceAll(' ','-') %> overall-order-status">
              <%= order.orderStatus %>
            </span>
          

        </div> -->

      </div>

      <div class="details-grid">

  <div class="left-column">
     <div class="card">

      <h3 class="card-title">
        Shipping Address
      </h3>

      <div class="shipping-address">

        <strong>
          <%= order.shippingAddress.fullName %>
        </strong>

        <span>
          <%= order.shippingAddress.phone %>
        </span>

        <span>
          <%= order.shippingAddress.line1 %>
        </span>

        <% if(order.shippingAddress.line2){ %>

          <span>
            <%= order.shippingAddress.line2 %>
          </span>

        <% } %>

        <span>
          <%= order.shippingAddress.city %>,
          <%= order.shippingAddress.state %>
        </span>

        <span>
          <%= order.shippingAddress.pincode %>
        </span>

      </div>

    </div>

    <div class="card">

      <h3 class="card-title">
        Customer
      </h3>

      <div class="info-list">

        <div class="info-row">
          <span>Name</span>
          <strong><%= order.user.name %></strong>
        </div>

        <div class="info-row">
          <span>Email</span>
          <strong><%= order.user.email %></strong>
        </div>

        <div class="info-row">
          <span>Phone</span>
          <strong><%= order.user.phone %></strong>
        </div>

      </div>

    </div>

    

  </div>

  <div class="right-column">
   

<div class="card">

  <h3 class="card-title">
    Order Summary
  </h3>

  <div class="summary-row">
    <span>Original Subtotal</span>

    <strong>
      ₹<%= Number(
        activeOriginalSubtotal
      ).toLocaleString("en-IN") %>
    </strong>
  </div>

  <% if (activeDiscountTotal > 0) { %>
    <div class="summary-row summary-discount">
      <span>Offer Discount</span>

      <strong>
        −₹<%= Number(
          activeDiscountTotal
        ).toLocaleString("en-IN") %>
      </strong>
    </div>
  <% } %>

  <div class="summary-row">
    <span>Active Subtotal</span>

    <strong>
      ₹<%= Number(
        activeSubtotal
      ).toLocaleString("en-IN") %>
    </strong>
  </div>

  <% if (cancelledAmount > 0) { %>
    <div class="summary-row summary-cancelled">
      <span>Cancelled Items</span>

      <strong>
        −₹<%= Number(
          cancelledAmount
        ).toLocaleString("en-IN") %>
      </strong>
    </div>
  <% } %>

  <div class="summary-row summary-gst">
    <span>GST Included</span>

    <strong>
      ₹<%= Number(gstAmount).toFixed(2) %>
    </strong>
  </div>

  <div class="summary-row">
    <span>Shipping</span>

    <strong>
      <%= shippingFee === 0
        ? "Free"
        : `₹${Number(
            shippingFee
          ).toLocaleString("en-IN")}` %>
    </strong>
  </div>

  <div class="summary-row total-row">
    <span>
      <%= partiallyCancelled
        ? "Current Total"
        : "Grand Total" %>
    </span>

    <strong>
      ₹<%= Number(total).toLocaleString("en-IN") %>
    </strong>
  </div>

</div>

    <div class="card payment-card">

      <div class="card-header-inline">

        <h3 class="card-title">
          Payment
        </h3>

        <span class="payment-badge <%= order.paymentStatus.toLowerCase() %>">
          <%= order.paymentStatus %>
        </span>

      </div>

      <div class="info-list">

        <div class="info-row">
          <span>Method</span>
          <strong><%= order.paymentMethod.replace(/([a-z])([A-Z])/g, "$1 $2") %></strong>
        </div>

        <div class="info-row">
          <span>Status</span>
          <strong class="payment-status-text">
            <%= order.paymentStatus %>
          </strong>
        </div>

      </div>

     <div class="cod-section">

<button
  type="button"
  id="markCodPaidBtn"
  class="cod-paid-btn"
  data-order-id="<%= order._id %>"
  <%= !showCodButton ? "disabled" : "" %>
>
  Mark COD Payment Received
</button>

</div>

    </div>

  </div>

</div>

      <div class="items-section">

        <div class="section-header">

          <h3>
            Order Items
            <span>
            (<%= order.items.length %> Items)
          </span>
          </h3>

          

        </div>

        <% order.items.forEach(item => { %>
                      <%
              const lockedStatuses = [
                "Delivered",
                "Cancelled",
                "Return Requested",
                "Return Accepted",
                "Return Rejected",
                "Returned",
                "Refunded"
              ];

              const returnStatuses = [
                "Return Requested",
                "Return Accepted",
                "Return Rejected",
                "Returned",
                "Refunded"
              ];

              const isLockedStatus = lockedStatuses.includes(item.status);
              const isReturnRelated = returnStatuses.includes(item.status);
            %>

          <div class="item-card">

            <img
              src="<%= item.productImage %>"
              alt="<%= item.productName %>"
              class="item-img"
            >

            <div class="item-info">

              <h4>
                <%= item.productName %>
              </h4>

              <p>
                <%= item.color %> • <%= item.size %>
              </p>

<div class="admin-item-price">

<div class="item-price-row">

  <span class="item-price-left">

    <span class="item-qty">
      <%= item.quantity %> ×
    </span>

    <span class="item-current-price">
      ₹<%= Number(item.unitPrice).toLocaleString("en-IN") %>
    </span>

    <% if (item.hasOffer) { %>
      <span class="item-old-price">
        ₹<%= Number(item.originalUnitPrice).toLocaleString("en-IN") %>
      </span>
    <% } %>

  </span>

  <span class="item-arrow">→</span>

  <strong class="item-total-price">
    ₹<%= Number(item.unitPrice * item.quantity).toLocaleString("en-IN") %>
  </strong>

</div>

  <% if (item.hasOffer) { %>
    <div class="item-offer-row">

      <span class="item-offer-badge">
        <% if (item.discountType === "PERCENTAGE") { %>
          <%= item.discountValue %>% OFF
        <% } else { %>
          ₹<%= Number(item.discountValue).toLocaleString("en-IN") %> OFF
        <% } %>
      </span>

      <span class="item-offer-name">
        <%= item.offerTitle %>
      </span>

    </div>
  <% } %>

</div>

            </div>

            <div
  class="item-status-block"
  data-item-id="<%= item._id %>"
>

              <span
                class="status item-status-badge <%= item.status.toLowerCase().replace(/\s+/g, '-') %>"
              >
                <%= item.status %>
              </span>

              <% if(item.statusUpdatedAt){ %>

                <small class="status-date item-status-date">

                <% if(item.status === "Delivered"){ %>
                  Delivered on
                <% } else if(item.status === "Shipped"){ %>
                  Shipped on
                <% } else if(item.status === "Cancelled"){ %>
                  Cancelled on
                <% } else if(item.status === "Return Requested"){ %>
                  Return requested on
                <% } else if(item.status === "Return Accepted"){ %>
                  Return accepted on
                <% } else if(item.status === "Return Rejected"){ %>
                  Return rejected on
                <% } else if(item.status === "Returned"){ %>
                  Returned on
                <% } else if(item.status === "Refunded"){ %>
                  Refunded on
                <% } else { %>
                  Updated on
                <% } %>

                  <%= new Date(item.statusUpdatedAt).toLocaleString("en-IN",{
                    day:"2-digit",
                    month:"short",
                    year:"numeric",
                    hour:"2-digit",
                    minute:"2-digit"
                  }) %>

                </small>

              <% } %>
              <% if (isReturnRelated) { %>
                <span class="return-flow-note">
                  This item is in return flow. Manage it from Return Management.
                </span>
              <% } %>

            </div>

            <div class="item-actions">



            <form
              class="status-form"
              data-item-id="<%= item._id %>"
            >

              <select
  name="status"
  class="status-select"
  <%= isLockedStatus ? "disabled" : "" %>
>

  <option
    value="Processing"
    <%= item.status === "Processing" ? "selected" : "" %>
    <%= ["Shipped","Delivered"].includes(item.status) ? "disabled" : "" %>
  >
    Processing
  </option>

  <option
    value="Shipped"
    <%= item.status === "Shipped" ? "selected" : "" %>
    <%= item.status === "Delivered" ? "disabled" : "" %>
  >
    Shipped
  </option>

  <option
    value="Delivered"
    <%= item.status === "Delivered" ? "selected" : "" %>
  >
    Delivered
  </option>

  <option
    value="Cancelled"
    <%= item.status === "Cancelled" ? "selected" : "" %>
    <%= item.status !== "Processing" ? "disabled" : "" %>
  >
    Cancelled
  </option>

</select>

<button
  type="button"
  class="update-status-btn"
  <%= isLockedStatus ? "disabled" : "" %>
>
  Update
</button>


</form>



</div>
</div>

<% }) %>

      </div>

    </div>

  </div>

</div>

<%- include("./partials/scripts") %>

<script>
  window.ORDER_ID = "<%= order._id %>";
</script>

<script src="/js/admin/orderDetails.js"></script>

</body>
</html>