<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head", {
    title: "Order Details"
  }) %>

  <link
    rel="stylesheet"
    href="/css/admin/order-details.css"
  >
</head>

<body>

<%- include("./partials/header", {
  title: "Order Details"
}) %>

<%- include("./partials/logout-modal") %>

<div class="layout">

  <%- include("./partials/sidebar", {
    active: "orders"
  }) %>

  <div class="main">

    <div class="content">

      <div class="page-top">

        <p class="breadcrumb">
          Admin Dashboard > Orders > <%= order.orderNumber %>
        </p>

        <h2 class="page-title">
          Order Details
        </h2>

      </div>

      <section class="order-overview">

        <div class="overview-main">

          <div class="order-number-row">

            <h3>
              #<%= order.orderNumber %>
            </h3>

            <span
              class="status <%= String(order.orderStatus)
                .toLowerCase()
                .replace(/\s+/g, '-') %>"
            >
              <%= order.orderStatus %>
            </span>

          </div>

          <p>
            Placed on
            <%= new Date(order.createdAt).toLocaleString(
              "en-IN",
              {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
              }
            ) %>
          </p>

        </div>

        <div class="overview-meta">

          <div class="overview-meta-item">
            <span>Items</span>
            <strong><%= order.items.length %></strong>
          </div>

          <div class="overview-meta-item">

            <span>Payment Method</span>

            <strong>
              <%= order.paymentMethod === "CashOnDelivery"
                ? "Cash On Delivery"
                : order.paymentMethod.replace(
                    /([a-z])([A-Z])/g,
                    "$1 $2"
                  ) %>
            </strong>

          </div>

          <div class="overview-meta-item">

            <span>Payment Status</span>

            <strong
              class="payment-text <%= String(
                order.paymentStatus
              ).toLowerCase() %>"
            >
              <%= order.paymentStatus %>
            </strong>

          </div>

        </div>

      </section>

      <section class="order-main-grid">

        <div class="left-info-stack">

          <div class="info-card">

            <div class="numbered-card-header">

              <span class="section-number">
                01
              </span>

              <div class="numbered-card-title">
                <span class="section-label">
                  CUSTOMER
                </span>

                <h3>
                  Customer Details
                </h3>
              </div>

            </div>

            <div class="customer-info-grid">

              <div class="detail-field">
                <span>Name</span>
                <strong>
                  <%= order.user?.name || "—" %>
                </strong>
              </div>

              <div class="detail-field">
                <span>Phone</span>
                <strong>
                  <%= order.user?.phone || "—" %>
                </strong>
              </div>

              <div class="detail-field detail-field-wide">
                <span>Email</span>
                <strong>
                  <%= order.user?.email || "—" %>
                </strong>
              </div>

            </div>

          </div>

          <div class="info-card">

            <div class="numbered-card-header">

              <span class="section-number">
                02
              </span>

              <div class="numbered-card-title">
                <span class="section-label">
                  DELIVERY
                </span>

                <h3>
                  Shipping Details
                </h3>
              </div>

            </div>

            <div class="shipping-top">

              <div class="detail-field">
                <span>Recipient</span>
                <strong>
                  <%= order.shippingAddress.fullName %>
                </strong>
              </div>

              <div class="detail-field">
                <span>Phone</span>
                <strong>
                  <%= order.shippingAddress.phone %>
                </strong>
              </div>

            </div>

            <div class="shipping-address">

              <span class="detail-label">
                Delivery Address
              </span>

              <div class="shipping-address-lines">

                <p>
                  <%= order.shippingAddress.line1 %>
                </p>

                <% if (order.shippingAddress.line2) { %>
                  <p>
                    <%= order.shippingAddress.line2 %>
                  </p>
                <% } %>

                <p>
                  <%= order.shippingAddress.city %>,
                  <%= order.shippingAddress.state %>
                  - <%= order.shippingAddress.pincode %>
                </p>

              </div>

            </div>

          </div>

          <div class="info-card">

            <div class="numbered-card-header">

              <span class="section-number">
                03
              </span>

              <div class="numbered-card-title">

                <span class="section-label">
                  PAYMENT
                </span>

                <h3>
                  Payment Details
                </h3>

              </div>

              <span
                class="payment-badge <%= String(
                  order.paymentStatus
                ).toLowerCase() %>"
              >
                <%= order.paymentStatus %>
              </span>

            </div>

            <div class="payment-info-grid">

              <div class="detail-field">

                <span>Method</span>

                <strong>
                  <%= order.paymentMethod === "CashOnDelivery"
                    ? "Cash On Delivery"
                    : order.paymentMethod.replace(
                        /([a-z])([A-Z])/g,
                        "$1 $2"
                      ) %>
                </strong>

              </div>

              <div class="detail-field">

                <span>Status</span>

                <strong
                  class="payment-text <%= String(
                    order.paymentStatus
                  ).toLowerCase() %>"
                >
                  <%= order.paymentStatus %>
                </strong>

              </div>

            </div>

            <% if (
              order.paymentMethod === "Razorpay" &&
              (
                order.razorpayOrderId ||
                order.razorpayPaymentId
              )
            ) { %>

              <div class="payment-reference-grid">

                <% if (order.razorpayOrderId) { %>

                  <div class="reference-field">
                    <span>Razorpay Order ID</span>
                    <strong>
                      <%= order.razorpayOrderId %>
                    </strong>
                  </div>

                <% } %>

                <% if (order.razorpayPaymentId) { %>

                  <div class="reference-field">
                    <span>Payment ID</span>
                    <strong>
                      <%= order.razorpayPaymentId %>
                    </strong>
                  </div>

                <% } %>

              </div>

            <% } %>

            <% if (
              order.paymentMethod === "CashOnDelivery" &&
              order.paymentStatus === "Pending"
            ) { %>

              <div class="cod-control">

                <p
                  id="codPaymentHint"
                  class="<%= showCodButton ? 'hidden' : '' %>"
                >
                  COD payment can be marked as received once all active items are delivered.
                </p>

                <button
                  type="button"
                  id="markCodPaidBtn"
                  class="cod-paid-btn <%= !showCodButton ? 'hidden' : '' %>"
                  data-order-id="<%= order._id %>"
                  <%= !showCodButton ? "disabled" : "" %>
                >
                  Mark COD Payment Received
                </button>

              </div>

            <% } %>

          </div>

        </div>

        <aside class="summary-card">

          <div class="summary-header">

            <div>
              <span class="summary-eyebrow">
                PAYMENT BREAKDOWN
              </span>

              <h3>
                Order Summary
              </h3>
            </div>

            <% if (order.coupon?.code) { %>
              <span class="coupon-chip">
                <%= order.coupon.code %>
              </span>
            <% } %>

          </div>

          <div class="summary-body">

            <% if (fullyCancelled) { %>

              <div class="summary-row">
                <span>Original subtotal</span>
                <strong>
                  ₹<%= Number(originalSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <% if (offerDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>Offer discount</span>
                  <strong>
                    −₹<%= Number(offerDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <% if (couponDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>
                    Coupon discount
                    <% if (order.coupon?.code) { %>
                      (<%= order.coupon.code %>)
                    <% } %>
                  </span>

                  <strong>
                    −₹<%= Number(couponDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <div class="summary-row">
                <span>Paid item value</span>
                <strong>
                  ₹<%= Number(discountedSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-row summary-cancelled">
                <span>Cancelled</span>
                <strong>
                  −₹<%= Number(discountedSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-row">
                <span>Shipping</span>
                <strong>Free</strong>
              </div>

              <div class="summary-row summary-muted">
                <span>GST Included</span>
                <strong>₹0.00</strong>
              </div>

              <div class="summary-total">
                <span>Current Total</span>
                <strong>₹0.00</strong>
              </div>

            <% } else if (partiallyCancelled) { %>

              <div class="summary-row">
                <span>Original subtotal</span>

                <strong>
                  ₹<%= Number(originalSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-row summary-cancelled">
                <span>Cancelled</span>

                <strong>
                  −₹<%= Number(cancelledOriginalAmount).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-row">
                <span>Remaining subtotal</span>

                <strong>
                  ₹<%= Number(activeOriginalSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <% if (activeOfferDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>Offer discount</span>

                  <strong>
                    −₹<%= Number(activeOfferDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <% if (activeCouponDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>
                    Coupon discount
                    <% if (order.coupon?.code) { %>
                      (<%= order.coupon.code %>)
                    <% } %>
                  </span>

                  <strong>
                    −₹<%= Number(activeCouponDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <div class="summary-row">
                <span>Payable items</span>

                <strong>
                  ₹<%= Number(activeDiscountedSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-row">
                <span>Shipping</span>

                <strong>
                  <%= Number(shippingFee) === 0
                    ? "Free"
                    : `₹${Number(shippingFee).toLocaleString("en-IN", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      })}` %>
                </strong>
              </div>

              <div class="summary-row summary-muted">
                <span>GST Included</span>

                <strong>
                  ₹<%= Number(gstAmount).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-total">
                <span>Current Total</span>

                <strong>
                  ₹<%= Number(total).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

            <% } else { %>

              <div class="summary-row">
                <span>Original subtotal</span>

                <strong>
                  ₹<%= Number(originalSubtotal).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <% if (offerDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>Offer discount</span>

                  <strong>
                    −₹<%= Number(offerDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <% if (couponDiscountTotal > 0) { %>
                <div class="summary-row summary-discount">
                  <span>
                    Coupon discount
                    <% if (order.coupon?.code) { %>
                      (<%= order.coupon.code %>)
                    <% } %>
                  </span>

                  <strong>
                    −₹<%= Number(couponDiscountTotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <% if (
                offerDiscountTotal > 0 ||
                couponDiscountTotal > 0
              ) { %>
                <div class="summary-row">
                  <span>Discounted subtotal</span>

                  <strong>
                    ₹<%= Number(discountedSubtotal).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>
                </div>
              <% } %>

              <div class="summary-row">
                <span>Shipping</span>

                <strong>
                  <%= Number(shippingFee) === 0
                    ? "Free"
                    : `₹${Number(shippingFee).toLocaleString("en-IN", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      })}` %>
                </strong>
              </div>

              <div class="summary-row summary-muted">
                <span>GST Included</span>

                <strong>
                  ₹<%= Number(gstAmount).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

              <div class="summary-total">
                <span>Grand Total</span>

                <strong>
                  ₹<%= Number(total).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  }) %>
                </strong>
              </div>

            <% } %>

          </div>

        </aside>

      </section>

      <section class="order-items-card">

        <div class="items-header">

          <div>
            <span class="items-eyebrow">
              PRODUCTS
            </span>

            <h3>
              Order Items
            </h3>
          </div>

          <span class="items-count">
            <%= order.items.length %>
            item<%= order.items.length !== 1 ? "s" : "" %>
          </span>

        </div>

        <div class="items-list">

          <% order.items.forEach((item) => { %>

            <%
              const lockedStatuses = [
                "Delivered",
                "Cancelled",
                "Return Requested",
                "Return Accepted",
                "Returned",
                "Refunded"
              ];

              const returnStatuses = [
                "Return Requested",
                "Return Accepted",
                "Returned",
                "Refunded"
              ];

              const isLockedStatus =
                lockedStatuses.includes(item.status);

              const isReturnRelated =
                returnStatuses.includes(item.status);

              const itemStatusClass =
                String(item.status)
                  .toLowerCase()
                  .replace(/\s+/g, "-");

              const quantity =
                Number(item.quantity) || 0;

              const originalUnitPrice =
                Number(item.originalUnitPrice) ||
                Number(item.unitPrice) ||
                0;

              const unitPrice =
                Number(item.unitPrice) || 0;

              const originalAmount =
                originalUnitPrice * quantity;

              const offerAmount =
                unitPrice * quantity;

              const offerDiscount =
                Math.max(
                  originalAmount - offerAmount,
                  0
                );

              const couponDiscount =
                Number(item.couponDiscountAmount) || 0;

              const finalAmount =
                Math.max(
                  offerAmount - couponDiscount,
                  0
                );
            %>

            <div
              class="order-item <%= item.status === 'Cancelled'
                ? 'order-item--cancelled'
                : '' %>"
            >

              <img
                src="<%= item.productImage || '/images/no-image.png' %>"
                alt="<%= item.productName %>"
                class="item-image"
              >

              <div class="item-product">

                <h4>
                  <%= item.productName %>
                </h4>

                <p class="item-variant">
                  <span><%= item.color %></span>
                  <span class="item-variant-separator">/</span>
                  <span><%= item.size %></span>
                  <span class="item-variant-separator">·</span>
                  <span>Qty <%= item.quantity %></span>
                </p>

              </div>

              <div class="item-pricing">

                <span class="item-column-label">
                  Amount
                </span>

                <div class="item-price-main">

                  <strong
                    class="item-final-price <%= item.status === 'Cancelled'
                      ? 'item-final-price--cancelled'
                      : '' %>"
                  >
                    ₹<%= Number(finalAmount).toLocaleString("en-IN", {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }) %>
                  </strong>

                  <% if (originalAmount > finalAmount) { %>

                    <span class="item-original-price">
                      ₹<%= Number(originalAmount).toLocaleString("en-IN", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      }) %>
                    </span>

                  <% } %>

                </div>

                <% if (
                  offerDiscount > 0 ||
                  couponDiscount > 0
                ) { %>

                  <div class="item-discounts">

                    <% if (offerDiscount > 0) { %>
                      <span>
                        Offer −₹<%= Number(offerDiscount).toLocaleString("en-IN", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2
                        }) %>
                      </span>
                    <% } %>

                    <% if (couponDiscount > 0) { %>
                      <span>
                        Coupon −₹<%= Number(couponDiscount).toLocaleString("en-IN", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2
                        }) %>
                      </span>
                    <% } %>

                  </div>

                <% } %>

              </div>

              <div class="item-status-column">

                <span class="item-column-label">
                  Status
                </span>

                <span
                  class="item-status item-status-<%= itemStatusClass %>"
                >
                  <%= item.status %>
                </span>

                <% if (item.statusUpdatedAt) { %>

                  <small class="item-status-date">
                    <%= new Date(item.statusUpdatedAt).toLocaleDateString(
                      "en-IN",
                      {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                      }
                    ) %>
                  </small>

                <% } %>

                <% if (isReturnRelated) { %>
                  <span class="return-flow-note">
                    Manage from Returns
                  </span>
                <% } %>

              </div>

              <div class="item-action-column">

                <span class="item-column-label">
                  Action
                </span>

                <form
                  class="status-form"
                  data-item-id="<%= item._id %>"
                >

<select
  name="status"
  class="status-select"
  <%= isLockedStatus ? "disabled" : "" %>
>

  <% if (item.status === "Placed") { %>

    <option
      value="Placed"
      selected
      disabled
    >
      Placed
    </option>

    <option value="Processing">
      Processing
    </option>

    <option value="Shipped">
      Shipped
    </option>

    <option value="Delivered">
      Delivered
    </option>

  <% } else if (item.status === "Processing") { %>

    <option
      value="Processing"
      selected
      disabled
    >
      Processing
    </option>

    <option value="Shipped">
      Shipped
    </option>

    <option value="Delivered">
      Delivered
    </option>

  <% } else if (item.status === "Shipped") { %>

    <option
      value="Shipped"
      selected
      disabled
    >
      Shipped
    </option>

    <option value="Delivered">
      Delivered
    </option>

  <% } else { %>

    <option
      value="<%= item.status %>"
      selected
      disabled
    >
      <%= item.status %>
    </option>

  <% } %>

</select>

                  <button
                    type="button"
                    class="update-status-btn"
                    <%= isLockedStatus ? "disabled" : "" %>
                  >
                    Update
                  </button>

                </form>

              </div>

            </div>

          <% }) %>

        </div>

      </section>

    </div>

  </div>

</div>

<%- include("./partials/scripts") %>

<script>
  window.ORDER_ID = "<%= order._id %>";
</script>

<script src="/js/admin/orderDetails.js"></script>

</body>

</html>