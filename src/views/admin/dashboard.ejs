<!DOCTYPE html>
<html lang="en">

<head>

  <%- include("./partials/head", {
    title: "Dashboard"
  }) %>

  <link
    rel="stylesheet"
    href="/css/admin/dashboard.css"
  >

</head>

<body>

  <%- include("./partials/header", {
    title: "Dashboard"
  }) %>

  <div class="layout">

    <%- include("./partials/sidebar", {
      active: "dashboard"
    }) %>

    <%- include("./partials/logout-modal") %>

    <div class="main">

      <div class="content">

        <div class="page-top">

          <div>

            <p class="breadcrumb">
              Admin Dashboard &gt; Overview
            </p>

            <h2 class="page-title">
              Dashboard
            </h2>

          </div>

        </div>


        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-top">

              <p>Total Sales</p>

              <i class="fa-solid fa-indian-rupee-sign"></i>

            </div>

            <h3>
              ₹<%= Number(stats?.totalSales || 0).toLocaleString(
                "en-IN",
                {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                }
              ) %>
            </h3>

            <span class="stat-description">
              Net sales revenue
            </span>

          </div>


          <div class="stat-card">

            <div class="stat-top">

              <p>Total Orders</p>

              <i class="fa-solid fa-bag-shopping"></i>

            </div>

            <h3>
              <%= stats?.totalOrders || 0 %>
            </h3>

            <span class="stat-description">
              Confirmed orders
            </span>

          </div>


          <div class="stat-card">

            <div class="stat-top">

              <p>Total Customers</p>

              <i class="fa-solid fa-users"></i>

            </div>

            <h3>
              <%= stats?.totalCustomers || 0 %>
            </h3>

            <span class="stat-description">
              Registered customers
            </span>

          </div>


          <div class="stat-card">

            <div class="stat-top">

              <p>Total Products</p>

              <i class="fa-solid fa-box"></i>

            </div>

            <h3>
              <%= stats?.totalProducts || 0 %>
            </h3>

            <span class="stat-description">
              Products in catalog
            </span>

          </div>

        </div>


        <div class="dashboard-card sales-chart-card">

          <div class="card-header">

            <div>

              <h3>
                Sales Overview
              </h3>

              <p>
                Net sales performance over time
              </p>

            </div>

            <div class="chart-controls">

              <select id="salesChartFilter">

                <option value="weekly">
                  Weekly
                </option>

                <option
                  value="monthly"
                  selected
                >
                  Monthly
                </option>

                <option value="yearly">
                  Yearly
                </option>

              </select>

              <select id="salesChartYear">

                <%
                  const currentYear =
                    new Date().getFullYear();
                %>

                <% for (
                  let year = currentYear;
                  year >= currentYear - 5;
                  year--
                ) { %>

                  <option value="<%= year %>">
                    <%= year %>
                  </option>

                <% } %>

              </select>

            </div>

          </div>


          <div class="chart-wrapper">

            <canvas id="salesChart"></canvas>

          </div>

        </div>


        <div class="ranking-grid">

          <div class="dashboard-card ranking-card">

            <div class="card-header">

              <div>

                <h3>
                  Best Selling Products
                </h3>

                <p>
                  Top 10 products by quantity sold
                </p>

              </div>

            </div>

            <div
              class="ranking-list"
              id="topProductsList"
            >

              <div class="ranking-empty">
                Loading...
              </div>

            </div>

          </div>


          <div class="dashboard-card ranking-card">

            <div class="card-header">

              <div>

                <h3>
                  Best Selling Categories
                </h3>

                <p>
                  Top 10 categories by quantity sold
                </p>

              </div>

            </div>

            <div
              class="ranking-list"
              id="topCategoriesList"
            >

              <div class="ranking-empty">
                Loading...
              </div>

            </div>

          </div>


          <div class="dashboard-card ranking-card">

            <div class="card-header">

              <div>

                <h3>
                  Best Selling Variants
                </h3>

                <p>
                  Top 10 size and color variants
                </p>

              </div>

            </div>

            <div
              class="ranking-list"
              id="topVariantsList"
            >

              <div class="ranking-empty">
                Loading...
              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

  <%- include("./partials/scripts") %>

  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/admin/dashboard.js"></script>

</body>

</html>